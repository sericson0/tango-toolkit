STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HISSTORY_KEYGEN_SECRET=
HISSTORY_STRIPE_PRICE_ID=
# Hisstory Lite ($9.99). LITE_KEYGEN_SECRET must match `liteSecret` in the
# Hisstory app (LicenseManager.cpp / keygen.py). Generate with: openssl rand -hex 32
HISSTORY_LITE_KEYGEN_SECRET=
HISSTORY_LITE_STRIPE_PRICE_ID=
# Lite -> Full upgrade ($30). Delivers a full key using HISSTORY_KEYGEN_SECRET,
# so only the Stripe price ID is needed here.
HISSTORY_UPGRADE_STRIPE_PRICE_ID=
TIGERTAG_KEYGEN_SECRET=
TIGERTAG_STRIPE_PRICE_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_AUDIENCE_ID=

# Email address that gets alerted when a paid checkout fails to provision
# (Stripe charged the customer but the license email did not send)
ADMIN_NOTIFICATION_EMAIL=

# Optional: Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Base URL audio clips are served from for the Name That Tango game, e.g.
# https://audio.tangotoolkit.com or the R2 public base URL. Object keys come
# from public/data/audio-map.csv's AudioKey column. For local dev, point this
# at a local folder of sample files, e.g. /audio-sample
PUBLIC_AUDIO_BASE_URL=
