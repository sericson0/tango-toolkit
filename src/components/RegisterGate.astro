---
/**
 * RegisterGate — a soft, dismissible "want to register?" popup for the free
 * web tools (Discographies, Tanda Builder, Name That Tango).
 *
 * Shows once per browser to visitors who haven't registered yet. If the user
 * has already registered (or captured their email anywhere on the site, e.g.
 * a software download), it never appears. Skipping is remembered so we don't
 * nag on every page. Registering posts to /api/register (same flow as the
 * /dj/register form) so the visitor also gets the Music Starter Package.
 */
interface Props {
  /** Used in the "No thanks, continue to …" link, e.g. "the Tanda Builder". */
  toolName?: string;
  /** Delay before the popup appears, in ms. */
  delay?: number;
}
const { toolName = 'the tools', delay = 1400 } = Astro.props;
---

<div id="register-gate" class="rg-modal" hidden data-delay={delay}>
  <div class="rg-backdrop" data-skip></div>
  <div class="rg-content" role="dialog" aria-modal="true" aria-labelledby="rg-title">
    <button class="rg-close" aria-label="Close" data-skip>&times;</button>
    <h3 id="rg-title">Join the Tango Toolkit</h3>
    <p>Register (it&rsquo;s free) to get a curated music starter pack and stay up to date on new tools and resources for the tango community.</p>
    <form id="rg-form">
      <input type="text" name="name" aria-label="Your name (optional)" placeholder="Your name (optional)" autocomplete="name" />
      <input type="email" name="email" aria-label="Email address" placeholder="your@email.com" autocomplete="email" required />
      <button type="submit" class="rg-primary">Register</button>
    </form>
    <button type="button" class="rg-skip" data-skip>No thanks, continue to {toolName}</button>
    <p class="rg-error" hidden></p>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('register-gate');
    if (!modal) return;

    const get = (k: string): string | null => {
      try { return localStorage.getItem(k); } catch { return null; }
    };
    const set = (k: string, v: string): void => {
      try { localStorage.setItem(k, v); } catch { /* private mode, ignore */ }
    };

    // Registered = they've handed us an email somewhere (register form, gate,
    // or a software download's email capture). Dismissed = they skipped before.
    const isRegistered = () => get('tt-registered') === '1' || !!get('tt-email-last');
    const isDismissed = () => get('tt-gate-dismissed') === '1';
    if (isRegistered() || isDismissed()) return;

    const form = modal.querySelector('#rg-form') as HTMLFormElement | null;
    const nameInput = modal.querySelector('input[name="name"]') as HTMLInputElement;
    const emailInput = modal.querySelector('input[name="email"]') as HTMLInputElement;
    const errorEl = modal.querySelector('.rg-error') as HTMLElement;
    const submitBtn = modal.querySelector('.rg-primary') as HTMLButtonElement;
    let lastFocused: HTMLElement | null = null;

    const getFocusable = (): HTMLElement[] =>
      Array.from(
        modal.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => el.offsetParent !== null);

    const open = () => {
      if (isRegistered() || isDismissed() || !modal.hidden) return;
      lastFocused = document.activeElement as HTMLElement | null;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => emailInput?.focus(), 50);
    };

    const close = () => {
      modal.hidden = true;
      document.body.style.overflow = '';
      if (lastFocused && document.contains(lastFocused)) lastFocused.focus();
    };

    const dismiss = () => {
      set('tt-gate-dismissed', '1');
      close();
    };

    modal.querySelectorAll('[data-skip]').forEach((el) => {
      el.addEventListener('click', dismiss);
    });

    document.addEventListener('keydown', (e) => {
      if (modal.hidden) return;
      if (e.key === 'Escape') {
        dismiss();
        return;
      }
      if (e.key !== 'Tab') return;
      const f = getFocusable();
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      } else if (active && !modal.contains(active)) {
        e.preventDefault();
        first.focus();
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      const name = nameInput.value.trim();
      if (!email) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Registering…';
      errorEl.hidden = true;

      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, name, focus: 'dj' }),
        });
        if (!res.ok) throw new Error('failed');

        set('tt-registered', '1');
        set('tt-email-last', email);

        const content = modal.querySelector('.rg-content') as HTMLElement;
        content.innerHTML =
          '<h3>You’re in!</h3>' +
          '<p>Thanks for registering. Check your inbox for your free music starter pack &mdash; enjoy exploring!</p>' +
          '<button type="button" class="rg-primary" data-done>Continue</button>';
        content.querySelector('[data-done]')?.addEventListener('click', close);
      } catch (err) {
        errorEl.textContent = 'Something went wrong. Please try again or continue.';
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Register';
      }
    });

    const delay = parseInt(modal.getAttribute('data-delay') || '1400', 10);
    if (document.readyState === 'complete') {
      setTimeout(open, delay);
    } else {
      window.addEventListener('load', () => setTimeout(open, delay));
    }
  })();
</script>

<style>
  .rg-modal[hidden] { display: none; }
  .rg-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .rg-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
  }
  .rg-content {
    position: relative;
    background: white;
    border-radius: var(--radius-lg);
    padding: 2rem 2rem 1.5rem;
    max-width: 460px;
    width: 100%;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    z-index: 1;
  }
  .rg-content h3 { margin: 0 0 0.5rem; font-size: 1.3rem; }
  .rg-content > p {
    color: var(--color-slate-600);
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .rg-close {
    position: absolute;
    top: 0.4rem;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-slate-400);
    padding: 0.25rem 0.5rem;
  }
  .rg-close:hover { color: var(--color-slate-700); }
  #rg-form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  #rg-form input {
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-slate-300);
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-family: inherit;
  }
  #rg-form input:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }
  .rg-primary {
    padding: 0.7rem 1rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.2s;
  }
  .rg-primary:hover:not(:disabled) { background: var(--color-primary-hover); }
  .rg-primary:disabled { opacity: 0.6; cursor: wait; }
  .rg-skip {
    width: 100%;
    background: none;
    border: none;
    color: var(--color-slate-500);
    cursor: pointer;
    padding: 0.5rem;
    font-size: 0.9rem;
    text-decoration: underline;
  }
  .rg-skip:hover { color: var(--color-slate-700); }
  .rg-error {
    color: var(--color-red-600);
    font-size: 0.9rem;
    margin: 0.5rem 0 0;
  }
</style>
