---
/**
 * DonationGate — a soft, dismissible donation prompt in front of "bonus"
 * content (extra set lists, upcoming resources, etc.).
 *
 * The content is NOT locked: every visitor can get to it. We simply *suggest*
 * a $10+ donation the first time they reach for it. Once someone donates (or
 * says they already have), we remember it in localStorage and never prompt
 * them again.
 *
 * Wiring (on any page that includes this component):
 *   - Put the bonus content inside an element with `data-donate-content` that
 *     starts hidden (the component hides it on load unless already unlocked).
 *   - Add a trigger element with `data-donate-gate` — clicking it opens the
 *     modal. After the visitor picks any option the content is revealed.
 *
 * localStorage key: `tt-donated` = '1' once they donate / say they have.
 */
---

<div id="donation-gate" class="dg-modal" hidden>
  <div class="dg-backdrop" data-dg-later></div>
  <div class="dg-content" role="dialog" aria-modal="true" aria-labelledby="dg-title">
    <button class="dg-close" aria-label="Close" data-dg-later>&times;</button>
    <h3 id="dg-title">Enjoying the Tango Toolkit?</h3>
    <p>
      All of this is free and always will be. If these resources help you on your
      DJ journey, please consider a <strong>$10 (or more) donation</strong> to help
      cover the costs and keep new tools and set lists coming.
    </p>

    <div class="dg-donate">
      <span class="dg-donate-label">Donate</span>
      <div class="dg-donate-buttons">
        <a href="https://buy.stripe.com/5kQ8wOfGU7bsdZ9gplgnK01" target="_blank" rel="noopener" class="dg-pay dg-pay-stripe" data-dg-donate>
          <span>Card / Apple Pay</span>
        </a>
        <a href="https://venmo.com/Sean-Ericson-1" target="_blank" rel="noopener" class="dg-pay dg-pay-venmo" data-dg-donate>
          <span>Venmo</span>
        </a>
        <button type="button" class="dg-pay dg-pay-zelle" data-dg-donate>
          <span>Zelle</span>
          <span class="dg-zelle-number">925-528-9221</span>
        </button>
      </div>
    </div>

    <div class="dg-secondary">
      <button type="button" class="dg-link" data-dg-already>I&rsquo;ve already donated</button>
      <button type="button" class="dg-link" data-dg-later>Maybe another day</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var modal = document.getElementById('donation-gate');
    if (!modal) return;

    var get = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
    var set = function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} };
    var isDonated = function () { return get('tt-donated') === '1'; };

    var content = document.querySelector('[data-donate-content]');
    var triggers = Array.prototype.slice.call(document.querySelectorAll('[data-donate-gate]'));

    var reveal = function () {
      if (content) content.hidden = false;
      triggers.forEach(function (t) { t.hidden = true; });
    };

    var openModal = function () {
      if (isDonated()) { reveal(); return; }
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    var closeModal = function () {
      modal.hidden = true;
      document.body.style.overflow = '';
    };

    // Returning donors: unlock immediately, no prompt.
    if (isDonated()) {
      reveal();
    } else if (content) {
      content.hidden = true;
    }

    triggers.forEach(function (t) {
      t.addEventListener('click', function (e) {
        e.preventDefault();
        openModal();
      });
    });

    // Donate + "already donated" → remember, reveal.
    modal.querySelectorAll('[data-dg-donate], [data-dg-already]').forEach(function (el) {
      el.addEventListener('click', function () {
        set('tt-donated', '1');
        closeModal();
        reveal();
      });
    });

    // "Maybe another day" → reveal but keep asking next time.
    modal.querySelectorAll('[data-dg-later]').forEach(function (el) {
      el.addEventListener('click', function () {
        closeModal();
        reveal();
      });
    });

    document.addEventListener('keydown', function (e) {
      if (!modal.hidden && e.key === 'Escape') { closeModal(); reveal(); }
    });
  })();
</script>

<style>
  .dg-modal[hidden] { display: none; }
  .dg-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .dg-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
  }
  .dg-content {
    position: relative;
    background: white;
    border-radius: var(--radius-lg);
    padding: 2rem 2rem 1.5rem;
    max-width: 480px;
    width: 100%;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    z-index: 1;
  }
  .dg-content h3 { margin: 0 0 0.5rem; font-size: 1.3rem; }
  .dg-content > p {
    color: var(--color-slate-600);
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .dg-close {
    position: absolute;
    top: 0.4rem;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-slate-400);
    padding: 0.25rem 0.5rem;
  }
  .dg-close:hover { color: var(--color-slate-700); }

  .dg-donate-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-slate-500);
    margin-bottom: 0.5rem;
  }
  .dg-donate-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .dg-pay {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    text-decoration: none;
    color: var(--color-slate-700);
    background: white;
    cursor: pointer;
    transition: all 0.15s;
    flex: 1;
    min-width: 110px;
    text-align: center;
  }
  .dg-pay:hover { border-color: var(--color-primary); background: var(--color-orange-50); }
  .dg-pay-stripe { border-color: #635bff; color: #635bff; }
  .dg-pay-stripe:hover { background: #f5f4ff; border-color: #635bff; }
  .dg-pay-venmo { border-color: #008cff; color: #008cff; }
  .dg-pay-venmo:hover { background: #f0f8ff; border-color: #008cff; }
  .dg-pay-zelle { border-color: #6c1cd3; color: #6c1cd3; }
  .dg-pay-zelle:hover { background: #f6f0ff; border-color: #6c1cd3; }
  .dg-zelle-number { font-weight: 400; font-size: 0.75rem; opacity: 0.8; }

  .dg-secondary {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .dg-link {
    background: none;
    border: none;
    color: var(--color-slate-500);
    cursor: pointer;
    padding: 0.25rem;
    font-size: 0.9rem;
    font-family: inherit;
    text-decoration: underline;
  }
  .dg-link:hover { color: var(--color-slate-700); }

  @media (max-width: 480px) {
    .dg-donate-buttons { flex-direction: column; }
  }
</style>
