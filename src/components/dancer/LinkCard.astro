---
import ToolIcon from './ToolIcon.astro';

/**
 * A cross-link out of the middle of a page — to another dancer topic, to the
 * DJ side, to a discography, or off-site.
 *
 *   <LinkCard
 *     kicker="DJ Toolkit"
 *     title="History of Tango Music"
 *     href="/dj/history-of-tango-music/"
 *     description="Why a 1935 D'Arienzo and a 1955 Pugliese feel so different under your feet."
 *   />
 */
interface Props {
  title: string;
  href: string;
  description?: string;
  /** Small label above the title — which part of the toolkit this leads to. */
  kicker?: string;
  tool?: string;
  external?: boolean;
}

const { title, href, description, kicker, tool, external = false } = Astro.props;
---

<a
  class="d-linkcard"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {tool && (
    <span class="d-linkcard-icon" aria-hidden="true">
      <ToolIcon name={tool} size={20} />
    </span>
  )}
  <span class="d-linkcard-body">
    {kicker && <span class="d-linkcard-kicker">{kicker}</span>}
    <span class="d-linkcard-title">{title}</span>
    {description && <span class="d-linkcard-desc">{description}</span>}
  </span>
  <span class="d-linkcard-arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
</a>

<style>
  .d-linkcard {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 1.5rem 0;
    padding: 0.95rem 1.1rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .d-linkcard:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
    color: inherit;
  }

  .d-linkcard-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--color-orange-50);
    color: var(--color-orange-600);
  }

  .d-linkcard-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .d-linkcard-kicker {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-orange-600);
  }

  .d-linkcard-title {
    font-weight: 600;
    color: var(--color-slate-800);
  }

  .d-linkcard-desc {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-slate-600);
  }

  .d-linkcard-arrow {
    flex-shrink: 0;
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
