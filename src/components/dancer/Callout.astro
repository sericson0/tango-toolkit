---
/**
 * A boxed aside inside dancer content.
 *
 *   <Callout type="question" title="Question to think about">
 *   Why does the cross happen?
 *   </Callout>
 *
 * Types:
 *   note      neutral aside
 *   tip       something that will make it feel better straight away
 *   warning   a common mistake
 *   question  a question to sit with (the red box in the notebooks)
 *   remark    a technical remark / "Rmk"
 *   source    attribution — "Learned from Alex Krebs"
 */
interface Props {
  type?: 'note' | 'tip' | 'warning' | 'question' | 'remark' | 'source';
  /** Heading shown at the top of the box. Defaults per type. */
  title?: string;
}

const { type = 'note', title } = Astro.props;

const DEFAULT_TITLES: Record<string, string> = {
  note: 'Note',
  tip: 'Tip',
  warning: 'Watch out',
  question: 'Question to think about',
  remark: 'Remark',
  source: 'Learned from',
};

const ICONS: Record<string, string> = {
  note: '<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>',
  tip: '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/>',
  warning:
    '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  question:
    '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  remark:
    '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  source:
    '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
};

const heading = title ?? DEFAULT_TITLES[type];
---

<aside class:list={['d-callout', `d-callout--${type}`]}>
  <p class="d-callout-head">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={ICONS[type]}
    />
    <span>{heading}</span>
  </p>
  <div class="d-callout-body">
    <slot />
  </div>
</aside>

<style>
  .d-callout {
    --cal-accent: var(--color-slate-400);
    --cal-bg: var(--color-slate-50);
    --cal-text: var(--color-slate-700);
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    background: var(--cal-bg);
    border: 1px solid color-mix(in srgb, var(--cal-accent) 35%, transparent);
    border-left: 3px solid var(--cal-accent);
    border-radius: var(--radius-md);
  }

  .d-callout-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--cal-text);
  }

  .d-callout-head svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .d-callout-body :global(> :first-child) { margin-top: 0; }
  .d-callout-body :global(> :last-child) { margin-bottom: 0; }

  .d-callout-body :global(p) {
    margin: 0 0 0.75rem;
    color: var(--color-slate-700);
  }

  .d-callout-body :global(ul),
  .d-callout-body :global(ol) {
    margin: 0 0 0.75rem;
    padding-left: 1.25rem;
    color: var(--color-slate-700);
  }

  .d-callout-body :global(li) { margin-bottom: 0.35rem; }

  .d-callout--note {
    --cal-accent: var(--color-slate-400);
    --cal-bg: var(--color-slate-50);
    --cal-text: var(--color-slate-700);
  }

  .d-callout--tip {
    --cal-accent: var(--color-green-500);
    --cal-bg: var(--color-green-50);
    --cal-text: var(--color-green-700);
  }

  .d-callout--warning {
    --cal-accent: var(--color-orange-400);
    --cal-bg: var(--color-orange-50);
    --cal-text: var(--color-orange-700);
  }

  .d-callout--question {
    --cal-accent: var(--color-red-500);
    --cal-bg: var(--color-red-50);
    --cal-text: var(--color-red-700);
  }

  .d-callout--remark {
    --cal-accent: var(--color-blue-500);
    --cal-bg: var(--color-blue-50);
    --cal-text: var(--color-blue-700);
  }

  .d-callout--source {
    --cal-accent: var(--color-slate-500);
    --cal-bg: white;
    --cal-text: var(--color-slate-600);
  }

  .d-callout--question .d-callout-body :global(p) {
    font-size: 1.05rem;
    color: var(--color-slate-800);
  }
</style>
