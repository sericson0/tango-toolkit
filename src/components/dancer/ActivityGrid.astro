---
/**
 * A small comparison grid — named categories side by side, each with a
 * tagline and a list of activities. Stacks to one column on narrow screens.
 *
 *   <ActivityGrid
 *     columns={[
 *       { title: 'Shop', tagline: 'Gather the ingredients', items: ['Classes', 'Videos'] },
 *       { title: 'Cook', tagline: 'Prepare them', items: ['Practicas', 'Drills'] },
 *     ]}
 *   />
 */
interface Column {
  title: string;
  tagline?: string;
  items: string[];
}

interface Props {
  columns: Column[];
}

const { columns } = Astro.props;
---

<div class="d-activity-grid">
  {columns.map((col) => (
    <section class="d-activity-col">
      <h4>{col.title}</h4>
      {col.tagline && <p class="d-activity-tagline">{col.tagline}</p>}
      <ul>
        {col.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  ))}
</div>

<style>
  .d-activity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
    gap: 0.9rem;
    margin: 1.75rem 0;
  }

  .d-activity-col {
    padding: 1.1rem 1.2rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-top: 3px solid var(--color-orange-400);
    border-radius: var(--radius-lg);
  }

  .d-activity-col h4 {
    margin: 0 0 0.15rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-orange-600);
  }

  .d-activity-tagline {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.45;
    color: var(--color-slate-500);
  }

  .d-activity-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d-activity-col li {
    position: relative;
    margin: 0 0 0.45rem;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-slate-700);
  }

  .d-activity-col li:last-child { margin-bottom: 0; }

  .d-activity-col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-orange-400);
  }
</style>
