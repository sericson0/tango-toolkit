---
/**
 * The toolbox icon set.
 *
 * Sections and topics pick an icon by name (see the `tool` field in
 * src/data/dancerSections.ts and src/content/config.ts).
 *
 * Two variants of the same names:
 *   line    Feather-style outlines, so they sit next to the icons already
 *           used elsewhere on the site. The default.
 *   doodle  Chunkier, rounded, softly filled — a cartoon toolbox look for
 *           small playful spots like the Dancer nav dropdown.
 *
 * Add a new icon by adding a key to PATHS. DOODLE_PATHS may cover only some
 * of them; anything missing there falls back to its line version.
 */
interface Props {
  name?: string;
  /** Pixel size; the icon is square. */
  size?: number;
  variant?: 'line' | 'doodle';
  class?: string;
}

const { name = 'wrench', size = 24, variant = 'line', class: className } = Astro.props;

const PATHS: Record<string, string> = {
  // Crossed wrench — Steps & Sequences
  tools:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  // Faders — Musicality
  sliders:
    '<line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>',
  // Two cogs — Connection
  gears:
    '<circle cx="9.5" cy="9.5" r="3"/><path d="M9.5 3v2M9.5 14v2M3 9.5h2M14 9.5h2M5.1 5.1l1.4 1.4M12.5 12.5l1.4 1.4M13.9 5.1l-1.4 1.4M6.5 12.5l-1.4 1.4"/><circle cx="17" cy="17" r="2.2"/><path d="M17 13.6v1.2M17 19.2v1.2M13.6 17h1.2M19.2 17h1.2"/>',
  // Toolbox — Starter Kit
  toolbox:
    '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><line x1="2" y1="12" x2="22" y2="12"/>',
  // Compass — Tools & Resources
  compass:
    '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  hammer:
    '<path d="M5.5 3h9l3.5 4-3.5 4h-9z"/><path d="M10 11v10"/>',
  pliers:
    '<path d="M9 2.5v7L5.5 13.5V21"/><path d="M15 2.5v7l3.5 4V21"/><path d="M9.6 8h4.8"/>',
  screwdriver:
    '<path d="M15 2.6 21.4 9l-2.6 2.6-6.4-6.4z"/><path d="M11.9 6.3 3.5 14.7 2.4 21.6l6.9-1.1 8.4-8.4"/>',
  ruler:
    '<rect x="2" y="8" width="20" height="8" rx="1.5"/><path d="M6.5 8v3M10.5 8v4.5M14.5 8v3M18.5 8v4.5"/>',
  // Alias — an open wrench reads the same as the crossed-tool mark
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  spanner:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
};

/**
 * Cartoon versions of the same tools: fatter strokes, rounder bodies, and a
 * soft currentColor wash inside each shape so they read as little toys rather
 * than diagram symbols. Shapes carry their own fill/stroke-width where they
 * differ from the <svg> defaults below.
 */
const SOFT = 'fill="currentColor" fill-opacity="0.16"';

const DOODLE_PATHS: Record<string, string> = {
  // Fat toolbox with a chunky handle and a latch — Starter Kit
  toolbox: `<rect x="2.2" y="8.6" width="19.6" height="11.4" rx="2.6" ${SOFT}/>
    <path d="M8.6 8.6V7.1a2 2 0 0 1 2-2h2.8a2 2 0 0 1 2 2v1.5"/>
    <path d="M2.2 13h5.6M16.2 13h5.6"/>
    <rect x="8.2" y="11.1" width="7.6" height="3.8" rx="1.4" ${SOFT}/>`,
  // Faders with oversized knobs — Musicality
  sliders: `<path d="M5 3.4v3.2M5 11.6v9"/><circle cx="5" cy="9.1" r="2.5" ${SOFT}/>
    <path d="M12 3.4v9.6M12 18.2v2.4"/><circle cx="12" cy="15.7" r="2.5" ${SOFT}/>
    <path d="M19 3.4v4.2M19 12.6v8"/><circle cx="19" cy="10.1" r="2.5" ${SOFT}/>`,
  // A big cog and its little buddy — Connection
  gears: `<circle cx="10" cy="10" r="3.6" ${SOFT}/>
    <path d="M10 3.8v1.6M10 14.6v1.6M3.8 10h1.6M14.6 10h1.6M5.6 5.6l1.2 1.2M13.2 13.2l1.2 1.2M14.4 5.6l-1.2 1.2M6.8 13.2l-1.2 1.2"/>
    <circle cx="17.6" cy="17.6" r="2.4" ${SOFT}/>
    <path d="M17.6 14.1v.9M17.6 20.2v.9M14.1 17.6h.9M20.2 17.6h.9"/>`,
  // Ring spanner with a stubby handle — Steps & Sequences
  tools: `<circle cx="16" cy="8" r="4.4" ${SOFT}/><circle cx="16" cy="8" r="1.9"/>
    <path d="M12.9 11.1 6 18" stroke-width="3.6"/>`,
  // Mallet: wedge head, fat handle — Drills
  hammer: `<path d="M4.6 4.6h9.2a2 2 0 0 1 1.6.8l2.4 3.2-2.4 3.2a2 2 0 0 1-1.6.8H4.6a1.9 1.9 0 0 1-1.9-1.9V6.5a1.9 1.9 0 0 1 1.9-1.9z" ${SOFT}/>
    <path d="M9.6 12.8v7.6" stroke-width="3.4"/>`,
  // Round compass with a fat needle — Tools & Resources
  compass: `<circle cx="12" cy="12" r="9" ${SOFT}/>
    <path d="M15.9 8.1 14 14l-5.9 1.9L10 10z" ${SOFT}/>
    <circle cx="12" cy="12" r="1.05" fill="currentColor" stroke="none"/>`,
  pliers: `<path d="M9 3v6.4L5.6 13.6V20.6"/><path d="M15 3v6.4l3.4 4.2V20.6"/>
    <circle cx="12" cy="10.6" r="1.4" fill="currentColor" stroke="none"/>`,
  // Fat grip bottom-left, flat blade top-right
  screwdriver: `<path d="M4.4 19.6 8 16" stroke-width="4.6"/><path d="M9.4 14.6 18.2 5.8"/>
    <path d="M17.7 3.9 20.1 6.3" stroke-width="2.4"/>`,
  ruler: `<rect x="1.8" y="8.4" width="20.4" height="7.2" rx="2.2" ${SOFT}/>
    <path d="M6.4 8.4v2.6M10.6 8.4v3.8M14.8 8.4v2.6M19 8.4v3.8"/>`,
};
DOODLE_PATHS.wrench = DOODLE_PATHS.tools;
DOODLE_PATHS.spanner = DOODLE_PATHS.tools;

const doodle = variant === 'doodle';
const path = (doodle ? DOODLE_PATHS[name] : undefined) ?? PATHS[name] ?? PATHS.wrench;
---

<svg
  class:list={['tool-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={doodle ? 1.9 : 1.8}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={path}
/>

<style>
  .tool-icon {
    flex-shrink: 0;
    display: block;
  }
</style>
