---
/**
 * An image with a caption — a scanned diagram, a photo, a screenshot.
 * Serves a .webp alongside the original when one exists, matching the
 * pattern used elsewhere on the site.
 *
 *   <Figure src="/images/dancer/walk-to-the-cross.png" alt="..." caption="..." />
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Cap the rendered width, e.g. "32rem". Defaults to full column width. */
  maxWidth?: string;
  /** Set false for images that are decorative or already described in text. */
  webp?: boolean;
}

const { src, alt, caption, maxWidth, webp = true } = Astro.props;
const webpSrc = src.replace(/\.(png|jpg|jpeg)$/i, '.webp');
const hasWebp = webp && webpSrc !== src;
---

<figure class="d-figure" style={maxWidth ? `max-width:${maxWidth}` : undefined}>
  <picture>
    {hasWebp && <source srcset={webpSrc} type="image/webp" />}
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </picture>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .d-figure {
    margin: 1.75rem auto;
  }

  .d-figure img {
    width: 100%;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    background: white;
  }

  .d-figure figcaption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-slate-500);
  }
</style>
