---
import { getTerm } from '../../data/dancerGlossary';

/**
 * An inline glossary term. Hover or focus to see the definition; if the term
 * has a page, the tooltip links to it.
 *
 *   <Term id="cruzada" />
 *   <Term id="cross-system">on the same foot</Term>
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const entry = getTerm(id);
const tipId = `term-${id}`;
---

{entry ? (
  <span class="d-term" tabindex="0" aria-describedby={tipId}>
    <span class="d-term-word"><slot>{entry.term}</slot></span>
    <span class="d-term-pop" id={tipId} role="note">
      <strong>{entry.term}</strong>
      {entry.definition}
      {entry.href && <a href={entry.href}>Read more →</a>}
    </span>
  </span>
) : (
  /* Unknown id — render the text plainly rather than losing the sentence. */
  <span><slot>{id}</slot></span>
)}

<style>
  .d-term {
    position: relative;
    display: inline;
    cursor: help;
  }

  .d-term-word {
    border-bottom: 1px dashed var(--color-orange-400);
  }

  .d-term:hover .d-term-word,
  .d-term:focus-visible .d-term-word {
    border-bottom-style: solid;
    color: var(--color-orange-700);
  }

  .d-term-pop {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%) translateY(0.25rem);
    z-index: 60;
    width: max-content;
    max-width: min(20rem, 70vw);
    padding: 0.7rem 0.85rem;
    background: var(--color-slate-800);
    color: var(--color-slate-100);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    font-size: 0.85rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.45;
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
    pointer-events: none;
  }

  .d-term:hover .d-term-pop,
  .d-term:focus-visible .d-term-pop {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .d-term-pop strong {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--color-orange-300);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .d-term-pop a {
    display: block;
    margin-top: 0.45rem;
    color: var(--color-orange-300);
    font-weight: 600;
    text-decoration: none;
  }

  .d-term-pop a:hover { color: var(--color-orange-200); }

  .d-term-pop::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--color-slate-800);
  }
</style>
