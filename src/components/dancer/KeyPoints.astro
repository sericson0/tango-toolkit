---
/**
 * The "if you remember one thing" box. Put a Markdown list inside.
 *
 *   <KeyPoints title="Remember">
 *
 *   - Keep your hips forward
 *   - Don't tilt the foot of the free leg
 *
 *   </KeyPoints>
 */
interface Props {
  title?: string;
}

const { title = 'Remember' } = Astro.props;
---

<section class="d-keypoints">
  <h4>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2 15.09 8.26 22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
    </svg>
    {title}
  </h4>
  <slot />
</section>

<style>
  .d-keypoints {
    margin: 1.75rem 0;
    padding: 1.1rem 1.35rem;
    background: var(--color-slate-800);
    border-radius: var(--radius-lg);
    color: var(--color-slate-100);
  }

  .d-keypoints h4 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-orange-300);
  }

  .d-keypoints h4 svg { width: 0.95rem; height: 0.95rem; }

  .d-keypoints :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d-keypoints :global(li) {
    position: relative;
    margin: 0 0 0.5rem;
    padding-left: 1.35rem;
    font-size: 0.97rem;
    line-height: 1.5;
    color: var(--color-slate-100);
  }

  .d-keypoints :global(li:last-child) { margin-bottom: 0; }

  .d-keypoints :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-orange-400);
  }

  .d-keypoints :global(p) {
    margin: 0 0 0.5rem;
    color: var(--color-slate-200);
  }

  .d-keypoints :global(strong) { color: white; }

  .d-keypoints :global(a) {
    color: var(--color-orange-300);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
