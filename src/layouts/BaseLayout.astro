---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "Tools and resources for tango DJs. Software and guides to elevate your tango DJing.", ogImage = "/og-preview.jpg" } = Astro.props;
const absoluteOgImage = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={`${title} | The Tango Toolkit`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content="The Tango Toolkit" />
    <meta name="twitter:title" content={`${title} | The Tango Toolkit`} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="theme-color" content="#f97316" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=DM+Serif+Display&display=swap" />
    <title>{title} | The Tango Toolkit</title>
    {import.meta.env.PUBLIC_GA_ID && (
      <script define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
        // Only load GA if the user has previously accepted cookies
        if (localStorage.getItem('cookie_consent') === 'accepted') {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        }
      </script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">
          <picture>
            <source srcset="/images/Logo.webp" type="image/webp" />
            <img src="/images/Logo.png" alt="Tango Toolkit" class="logo-img" width="40" height="40" />
          </picture>
          <span class="logo-text">The Tango Toolkit</span>
        </a>
        <nav class="nav">
          <a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>Home</a>
          <div class="nav-group">
            <button type="button" class={`nav-group-toggle ${Astro.url.pathname.startsWith('/dj') ? 'active' : ''}`} aria-expanded="false" aria-haspopup="true">
              DJ <span class="nav-caret" aria-hidden="true">&#9662;</span>
            </button>
            <div class="nav-dropdown">
              <a href="/dj/starter-kit/" class={Astro.url.pathname.startsWith('/dj/starter-kit') ? 'active' : ''}>DJ Starter Kit</a>
              <a href="/dj/tools/" class={Astro.url.pathname.startsWith('/dj/tools') || Astro.url.pathname.startsWith('/dj/software') ? 'active' : ''}>All DJ Tools</a>
              <div class="nav-dropdown-divider" role="separator"></div>
              <a href="/dj/tools/#dj-players" class="nav-sub">DJ Players</a>
              <a href="/dj/tools/#displays-projections" class="nav-sub">Displays &amp; Projections</a>
              <a href="/dj/tools/#tanda-builders" class="nav-sub">Tanda Builders</a>
              <a href="/dj/tools/#plugins-sound-quality" class="nav-sub">Plugins &amp; Sound Quality</a>
              <div class="nav-dropdown-divider" role="separator"></div>
              <a href="/dj/tanda-builder/" class={Astro.url.pathname.startsWith('/dj/tanda-builder') ? 'active' : ''}>Tanda Builder (Web)</a>
              <a href="/dj/articles/" class={Astro.url.pathname.startsWith('/dj/articles') || Astro.url.pathname.startsWith('/dj/history') ? 'active' : ''}>Resources &amp; Articles</a>
            </div>
          </div>
          <div class="nav-group">
            <button type="button" class={`nav-group-toggle ${Astro.url.pathname.startsWith('/dancer') ? 'active' : ''}`} aria-expanded="false" aria-haspopup="true">
              Dancer <span class="nav-caret" aria-hidden="true">&#9662;</span>
            </button>
            <div class="nav-dropdown">
              <a href="/dancer/" class={Astro.url.pathname === '/dancer/' ? 'active' : ''}>Dancer Resources</a>
              <a href="/dancer/videos/" class={Astro.url.pathname.startsWith('/dancer/videos') ? 'active' : ''}>Videos</a>
              <a href="/dancer/videos/#interviews" class="nav-sub">Interviews</a>
            </div>
          </div>
          <a href="/discographies/" class={Astro.url.pathname.startsWith('/discographies') ? 'active' : ''}>Discographies</a>
          <a href="/name-that-tango/" class={Astro.url.pathname.startsWith('/name-that-tango') ? 'active' : ''}>Name That Tango</a>
        </nav>
        <button class="nav-toggle" aria-label="Toggle menu" type="button">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <strong>The Tango Toolkit</strong>
            <p>Resources for tango DJs.</p>
            <a href="https://www.notasdeoro.com" target="_blank" rel="noopener noreferrer">Notas de Oro</a>
          </div>
          <div>
            <strong>DJ Tools</strong>
            <a href="/dj/tools/#dj-players">DJ Players</a>
            <a href="/dj/tools/#displays-projections">Displays &amp; Projections</a>
            <a href="/dj/tools/#tanda-builders">Tanda Builders</a>
            <a href="/dj/tools/#plugins-sound-quality">Plugins &amp; Sound Quality</a>
          </div>
          <div>
            <strong>Resources</strong>
            <a href="/dj/starter-kit/">DJ Starter Kit</a>
            <a href="/discographies/">Discographies</a>
            <a href="/name-that-tango/">Name That Tango</a>
            <a href="/dj/articles/">Articles &amp; Links</a>
          </div>
          <div>
            <strong>For Dancers</strong>
            <a href="/dancer/">Dancer Resources</a>
            <a href="/dancer/videos/">Videos</a>
            <a href="/dancer/videos/#interviews">Interviews</a>
          </div>
          <div>
            <strong>Help</strong>
            <a href="/dj/faq/">FAQ & Changelog</a>
            <a href="/dj/account/">My Licenses</a>
            <a href="/support/">Support</a>
          </div>
          <div>
            <strong>Legal</strong>
            <a href="/privacy/">Privacy Policy</a>
            <a href="/terms/">Terms of Service</a>
            <a href="/unsubscribe/">Unsubscribe</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} The Tango Toolkit</p>
        </div>
      </div>
    </footer>

    {import.meta.env.PUBLIC_GA_ID && (
      <div class="cookie-banner" id="cookieBanner" style="display:none;" data-ga-id={import.meta.env.PUBLIC_GA_ID}>
        <div class="cookie-banner-inner">
          <p>We use cookies for analytics to help improve this site. <a href="/privacy/">Learn more</a></p>
          <div class="cookie-buttons">
            <button class="btn btn-sm btn-cookie-decline" id="cookieDecline">Decline</button>
            <button class="btn btn-primary btn-sm" id="cookieAccept">Accept</button>
          </div>
        </div>
      </div>
    )}

    <script>
      // Mobile nav toggle
      document.querySelector('.nav-toggle')?.addEventListener('click', () => {
        document.querySelector('.nav')?.classList.toggle('open');
      });

      // Close mobile nav when a link is clicked
      document.querySelectorAll('.nav a').forEach((link) => {
        link.addEventListener('click', () => {
          document.querySelector('.nav')?.classList.remove('open');
          document.querySelectorAll('.nav-group.open').forEach((g) => {
            g.classList.remove('open');
            g.querySelector('.nav-group-toggle')?.setAttribute('aria-expanded', 'false');
          });
        });
      });

      // Dropdown groups (click for touch/mobile; hover handled in CSS)
      document.querySelectorAll('.nav-group').forEach((group) => {
        const toggle = group.querySelector('.nav-group-toggle');
        toggle?.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = group.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(isOpen));
        });
      });

      const closeGroups = () => {
        document.querySelectorAll('.nav-group.open').forEach((g) => {
          g.classList.remove('open');
          g.querySelector('.nav-group-toggle')?.setAttribute('aria-expanded', 'false');
        });
      };

      document.addEventListener('click', closeGroups);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeGroups();
      });

      // Cookie consent banner (GDPR opt-in)
      (function() {
        var banner = document.getElementById('cookieBanner');
        var acceptBtn = document.getElementById('cookieAccept');
        var declineBtn = document.getElementById('cookieDecline');
        if (!banner || !acceptBtn || !declineBtn) return;

        var consent = localStorage.getItem('cookie_consent');
        if (consent) return; // already chose — GA loaded (or not) in <head>

        banner.style.display = '';

        acceptBtn.addEventListener('click', function() {
          localStorage.setItem('cookie_consent', 'accepted');
          banner.style.display = 'none';
          // Load GA now for this page view
          var gaId = banner.getAttribute('data-ga-id');
          if (gaId) {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', gaId);
          }
        });

        declineBtn.addEventListener('click', function() {
          localStorage.setItem('cookie_consent', 'declined');
          banner.style.display = 'none';
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: white;
    border-bottom: 1px solid var(--color-slate-200);
    box-shadow: var(--shadow-sm);
  }

  .site-header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-slate-900);
    font-weight: 400;
  }

  .logo:hover {
    color: var(--color-primary);
  }

  .logo-img {
    height: 2.5rem;
    width: auto;
  }

  .nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav a {
    font-weight: 500;
    color: var(--color-slate-600);
  }

  .nav a:hover,
  .nav a.active {
    color: var(--color-primary);
  }

  /* Dropdown group */
  .nav-group {
    position: relative;
  }

  .nav-group-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-slate-600);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .nav-group-toggle:hover,
  .nav-group-toggle.active {
    color: var(--color-primary);
  }

  .nav-caret {
    font-size: 0.7rem;
    transition: transform 0.15s;
  }

  .nav-group.open .nav-caret {
    transform: rotate(180deg);
  }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 230px;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 0.5rem 0;
    z-index: 150;
  }

  /* Invisible hover bridge so the pointer can travel to the dropdown */
  .nav-dropdown::before {
    content: '';
    position: absolute;
    top: -0.75rem;
    left: 0;
    right: 0;
    height: 0.75rem;
  }

  .nav-group.open .nav-dropdown {
    display: block;
  }

  @media (min-width: 769px) {
    .nav-group:hover .nav-dropdown,
    .nav-group:focus-within .nav-dropdown {
      display: block;
    }
  }

  .nav-dropdown a {
    display: block;
    padding: 0.45rem 1.25rem;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .nav-dropdown a:hover {
    background: var(--color-orange-50);
  }

  .nav-dropdown a.nav-sub {
    padding-left: 2rem;
    font-size: 0.9rem;
  }

  .nav-dropdown-divider {
    border-top: 1px solid var(--color-slate-200);
    margin: 0.4rem 0;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    transition: background 0.15s;
  }

  .nav-toggle:hover {
    background: var(--color-slate-100);
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--color-slate-700);
    transition: background 0.15s;
  }

  .nav-toggle:hover span {
    background: var(--color-primary);
  }

  @media (max-width: 768px) {
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: white;
      padding: 1.5rem;
      gap: 1rem;
      border-bottom: 1px solid var(--color-slate-200);
      display: none;
    }

    .nav.open {
      display: flex;
    }

    .nav-toggle {
      display: flex;
    }

    /* Dropdown renders inline inside the mobile panel */
    .nav-group {
      width: 100%;
      text-align: center;
    }

    .nav-group-toggle {
      width: 100%;
      justify-content: center;
    }

    .nav-dropdown {
      position: static;
      transform: none;
      min-width: 0;
      border: none;
      box-shadow: none;
      background: var(--color-slate-50);
      border-radius: var(--radius-md);
      margin-top: 0.75rem;
      padding: 0.5rem 0;
    }

    .nav-dropdown::before {
      display: none;
    }

    .nav-dropdown a,
    .nav-dropdown a.nav-sub {
      padding: 0.5rem 1rem;
      text-align: center;
      white-space: normal;
    }
  }

  .site-footer {
    margin-top: 4rem;
    padding: 3rem 0;
    background: var(--color-slate-800);
    color: var(--color-slate-300);
  }

  .site-footer a {
    color: var(--color-orange-300);
    display: block;
    margin-top: 0.5rem;
  }

  .site-footer a:hover {
    color: var(--color-orange-200);
  }

  .footer-grid {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .footer-bottom {
    max-width: var(--container-max);
    margin: 2.5rem auto 0;
    padding: 1.25rem 1.5rem 0;
    border-top: 1px solid var(--color-slate-700);
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-slate-400);
  }

  /* Cookie Consent Banner */
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: var(--color-slate-800);
    border-top: 1px solid var(--color-slate-700);
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.15);
  }

  .cookie-banner-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cookie-banner p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-slate-300);
  }

  .cookie-banner a {
    color: var(--color-orange-300);
    text-decoration: underline;
  }

  .cookie-banner a:hover {
    color: var(--color-orange-200);
  }

  .cookie-buttons {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .btn-sm {
    padding: 0.35rem 1rem;
    font-size: 0.85rem;
  }

  .btn-cookie-decline {
    background: transparent;
    color: var(--color-slate-400);
    border: 1px solid var(--color-slate-600);
  }

  .btn-cookie-decline:hover {
    color: var(--color-slate-200);
    border-color: var(--color-slate-400);
  }

</style>
