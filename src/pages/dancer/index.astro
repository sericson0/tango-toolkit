---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { dancerResources } from '../../data/dancerResources';

// Inline icons (Feather, MIT) — consistent rendering across platforms, unlike emoji
const ICON_ATTRS = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const VIDEO_SVG = `<svg ${ICON_ATTRS}><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`;
const MIC_SVG = `<svg ${ICON_ATTRS}><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>`;
---

<BaseLayout title="Dancer Resources" description="Videos, interviews, and resources for tango dancers. More on the way — this section is under construction.">
  <PageHero title="Dancer Resources" lead="Videos, interviews, and resources for tango dancers." />

  <section class="dancer-section">
    <div class="container">
      <p class="callout callout-warning construction-note">
        <strong>Under construction</strong>
        We&rsquo;re building out a home for tango dancers &mdash; videos, interviews, and guides to
        deepen your dancing and your ear for the music. Check back soon, and
        <a href="/#subscribe">subscribe</a> to hear when new resources land.
      </p>

      <h2 class="section-heading">Explore</h2>
      <div class="dancer-grid">
        <a href="/dancer/videos/" class="dancer-card">
          <div class="dancer-card-icon" set:html={VIDEO_SVG}></div>
          <div>
            <h3>Videos</h3>
            <p>Performances, lessons, and talks to deepen your dancing and your ear.</p>
            <span class="card-cta">Watch &rarr;</span>
          </div>
        </a>

        <a href="/dancer/interviews/" class="dancer-card">
          <div class="dancer-card-icon" set:html={MIC_SVG}></div>
          <div>
            <h3>Interviews</h3>
            <p>A searchable library of conversations with dancers, teachers, and maestros of the tango world.</p>
            <span class="card-cta">Listen in &rarr;</span>
          </div>
        </a>
      </div>

      <h2 class="section-heading" style="margin-top: 2.5rem;">Resources</h2>
      <div class="resource-list">
        {dancerResources.map((resource) => (
          <article class="resource-card">
            {resource.image && (
              <div class="resource-card-media">
                <img src={resource.image} alt="" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="resource-card-body">
              <h3>{resource.title}</h3>
              <span class="resource-card-author">by {resource.author}</span>
              <p class="resource-card-desc">{resource.description}</p>
              <div class="resource-card-actions">
                {resource.downloadUrl && (
                  <a
                    href={resource.downloadUrl}
                    class="resource-card-dl"
                    target={resource.external ? '_blank' : undefined}
                    rel={resource.external ? 'noopener noreferrer' : undefined}
                  >{resource.downloadLabel ?? 'Download'}</a>
                )}
                <a
                  href={resource.url}
                  class="resource-card-cta"
                  target={resource.external ? '_blank' : undefined}
                  rel={resource.external ? 'noopener noreferrer' : undefined}
                >{resource.external ? 'Visit site ↗' : 'Learn more →'}</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <h2 class="section-heading" style="margin-top: 2.5rem;">Coming soon</h2>
      <ul class="coming-list">
        <li>A curated library of dancer videos and interviews</li>
        <li>Guides to understanding tango music from the dance floor</li>
        <li>Etiquette, cabeceo, and codigos for milongas</li>
        <li>Recommended teachers, festivals, and communities</li>
      </ul>

      <p class="prose" style="margin-top: 2rem;">
        In the meantime, explore our <a href="/discographies/">discographies</a> and the
        <a href="/dj/history-of-tango-music/">history of tango music</a> to learn more about
        the music you dance to.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .dancer-section {
    padding: 3rem 0;
  }

  .construction-note {
    margin-bottom: 2.5rem;
  }

  .construction-note a {
    color: var(--color-orange-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .section-heading {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
  }

  .dancer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 720px;
  }

  .dancer-card {
    display: flex;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: all 0.2s;
  }

  .dancer-card:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .dancer-card-icon {
    flex-shrink: 0;
    color: var(--color-orange-500);
  }

  .dancer-card-icon :global(svg) {
    width: 2rem;
    height: 2rem;
  }

  .dancer-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
  }

  .dancer-card p {
    margin: 0 0 0.75rem;
    color: var(--color-slate-600);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .card-cta {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.95rem;
  }

  .coming-list {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--color-slate-600);
    line-height: 1.8;
    max-width: 60ch;
  }

  /* Resource cards */
  .resource-list {
    display: grid;
    gap: 1.5rem;
    max-width: 640px;
  }

  .resource-card {
    position: relative;
    display: flex;
    gap: 1.25rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.2s;
  }

  .resource-card:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .resource-card-media {
    flex-shrink: 0;
    width: 150px;
    background: var(--color-slate-100);
  }

  .resource-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .resource-card-body {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.25rem 1.25rem 0;
  }

  .resource-card-body h3 {
    margin: 0 0 0.15rem;
    font-size: 1.2rem;
  }

  .resource-card-author {
    margin-bottom: 0.6rem;
    font-size: 0.8rem;
    color: var(--color-slate-500);
  }

  .resource-card-desc {
    margin: 0 0 1rem;
    color: var(--color-slate-600);
    font-size: 0.92rem;
    line-height: 1.55;
    flex: 1;
  }

  .resource-card-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  /* Primary link stretches over the whole card */
  .resource-card-cta {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .resource-card-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  /* Download button sits above the stretched link */
  .resource-card-dl {
    position: relative;
    z-index: 1;
    font-size: 0.82rem;
    font-weight: 600;
    color: white;
    background: var(--color-primary);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-md);
    white-space: nowrap;
    transition: background 0.2s;
  }

  .resource-card-dl:hover {
    background: var(--color-primary-hover);
    color: white;
  }

  @media (max-width: 520px) {
    .resource-card {
      flex-direction: column;
    }

    .resource-card-media {
      width: 100%;
      height: 170px;
    }

    .resource-card-body {
      padding: 0 1.25rem 1.25rem;
    }
  }
</style>
