---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import {
  interviews,
  interviewGroups,
  interviewCategories,
  getInterviewGroup,
  getInterviewCategory,
  interviewThumbnail,
  interviewSource,
  interviewTitle,
  interviewBlurb,
  guestNames,
} from '../../../data/interviews';

// Inline icons (Feather, MIT)
const ICON = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const MIC_SVG = `<svg ${ICON}><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>`;
const VIDEO_SVG = `<svg ${ICON}><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`;

// Render-ready view for every interview.
const cards = interviews.map((iv) => {
  const group = getInterviewGroup(iv.groupId)!;
  const catLabels = iv.categories.map((c) => getInterviewCategory(c)?.label ?? c);
  const searchText = [
    interviewTitle(iv),
    iv.guest,
    ...guestNames(iv.guest),
    group.name,
    group.host ?? '',
    ...catLabels,
    interviewSource(iv),
    iv.format,
  ].join(' ').toLowerCase();
  return {
    iv,
    group,
    title: interviewTitle(iv),
    blurb: interviewBlurb(iv, group),
    thumb: interviewThumbnail(iv, group),
    source: interviewSource(iv),
    catLabels,
    searchText,
  };
});

// Data the client script needs to build section headers on the fly.
const groupsMeta = Object.fromEntries(
  interviewGroups.map((g) => [g.id, {
    name: g.name,
    host: g.host ?? '',
    description: g.description,
    logo: g.logo ?? '',
    website: g.website ?? '',
    donateLinks: g.donateLinks ?? [],
  }])
);
const groupOrder = interviewGroups.map((g) => g.id);
const categoryList = interviewCategories.map((c) => ({ id: c.id, label: c.label, blurb: c.blurb }));
const totalCount = cards.filter((c) => !c.iv.seriesCard).length;
---

<BaseLayout
  title="Tango Interviews"
  description="A searchable library of tango interviews — video and podcast conversations with dancers, teachers, musicians, and maestros. Browse by series, category, or artist, and support the groups that make them."
>
  <PageHero
    title="Interviews"
    lead="A searchable library of conversations with the dancers, musicians, and maestros of tango. Browse by series, category, or artist."
    backHref="/dancer/"
    backText="Back to Dancer Resources"
  />

  <!-- ===== Controls (sticky) ===== -->
  <div class="iv-controls">
    <div class="container">
      <div class="controls-row controls-top">
        <div class="search-wrap">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" class="search-input" data-search placeholder="Search by name, series, or topic…" aria-label="Search interviews" autocomplete="off" />
          <button type="button" class="search-clear" data-search-clear aria-label="Clear search" hidden>&times;</button>
        </div>
        <div class="format-filters" role="group" aria-label="Filter by format">
          <button type="button" class="pill is-active" data-format="all">All</button>
          <button type="button" class="pill" data-format="video">Video</button>
          <button type="button" class="pill" data-format="podcast">Podcast</button>
        </div>
      </div>

      <div class="controls-row">
        <span class="controls-label">Category</span>
        <div class="chip-row">
          {interviewCategories.map((c) => (
            <button type="button" class="chip" data-filter-category={c.id}>{c.label}</button>
          ))}
        </div>
      </div>

      <div class="controls-row">
        <span class="controls-label">Series</span>
        <div class="chip-row">
          {interviewGroups.map((g) => (
            <button type="button" class="chip" data-filter-series={g.id}>{g.name}</button>
          ))}
        </div>
      </div>

      <div class="controls-row controls-groupby">
        <span class="controls-label">Group by</span>
        <div class="format-filters" role="group" aria-label="Group results by">
          <button type="button" class="pill is-active" data-groupby="series">Series</button>
          <button type="button" class="pill" data-groupby="category">Category</button>
          <button type="button" class="pill" data-groupby="artist">Artist</button>
        </div>
      </div>
    </div>
  </div>

  <section class="iv-section">
    <div class="container">
      <p class="result-count" data-result-count aria-live="polite" hidden></p>

      <!-- Card pool — hidden source; JS clones from here into #results grouped per the view -->
      <div id="iv-pool" hidden>
        {cards.map(({ iv, group, title, blurb, thumb, source, catLabels, searchText }) => (
          <article
            class="interview-card"
            data-card
            data-group={iv.groupId}
            data-format={iv.format}
            data-categories={iv.categories.join(',')}
            data-guest={iv.guest}
            data-series-card={iv.seriesCard ? '1' : ''}
            data-search={searchText}
          >
            <a class="card-media" href={iv.url} target="_blank" rel="noopener noreferrer" aria-label={`${iv.seriesCard ? 'Browse' : 'Open'}: ${title}`}>
              {thumb ? (
                <img src={thumb} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="card-media-fallback" set:html={iv.format === 'podcast' ? MIC_SVG : VIDEO_SVG} />
              )}
              <span class={`format-badge format-badge--${iv.format}`}>{iv.format === 'podcast' ? 'Podcast' : 'Video'}</span>
            </a>
            <div class="card-body">
              <div class="card-group">
                <span class="card-group-logo" aria-hidden="true">
                  {group.logo ? (
                    <img src={group.logo} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="card-group-logo-fallback" set:html={MIC_SVG} />
                  )}
                </span>
                <span class="card-group-name">{group.name}</span>
              </div>
              <h3 class="card-title">{title}</h3>
              {iv.guest && !iv.seriesCard && <p class="card-guest">with {iv.guest}</p>}
              <p class="card-desc">{blurb}</p>
              {catLabels.length > 0 && (
                <div class="card-cats">
                  {catLabels.map((c) => <span class="card-cat">{c}</span>)}
                </div>
              )}
              <div class="card-foot">
                {source && (
                  <span class="card-source">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    {source}
                  </span>
                )}
                <span class="card-cta">{iv.seriesCard ? 'Browse the series ↗' : (iv.format === 'podcast' ? 'Listen ↗' : 'Watch ↗')}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div id="iv-results"></div>

      <p class="no-results" data-no-results hidden>
        No interviews match your filters.
        <button type="button" class="linkish" data-reset>Clear everything</button>.
      </p>

      <div class="callout callout-tip suggest">
        <strong>Know an interview series we should add?</strong>
        <p>
          We&rsquo;re growing this library. If you make tango interviews &mdash; or love a series that belongs here &mdash;
          email <a href="mailto:tangotoolkit@gmail.com">tangotoolkit@gmail.com</a> with the link (and a donation page, if there is one).
        </p>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ groupsMeta, groupOrder, categoryList, totalCount }}>
    (function () {
      var MIC = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>';
      var HEART = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';

      var pool = document.getElementById('iv-pool');
      var results = document.getElementById('iv-results');
      if (!pool || !results) return;
      var allCards = Array.prototype.slice.call(pool.querySelectorAll('[data-card]'));

      var catLabelById = {};
      categoryList.forEach(function (c) { catLabelById[c.id] = c.label; });

      // State
      var query = '';
      var format = 'all';
      var groupBy = 'series';
      var activeCats = {};   // id -> true
      var activeSeries = {}; // id -> true

      var searchInput = document.querySelector('[data-search]');
      var clearBtn = document.querySelector('[data-search-clear]');
      var countEl = document.querySelector('[data-result-count]');
      var noResults = document.querySelector('[data-no-results]');

      function anyKey(o) { for (var k in o) { if (o[k]) return true; } return false; }

      function matches(card) {
        // format
        if (format !== 'all' && card.getAttribute('data-format') !== format) return false;
        // series filter
        if (anyKey(activeSeries) && !activeSeries[card.getAttribute('data-group')]) return false;
        // category filter
        if (anyKey(activeCats)) {
          var cats = (card.getAttribute('data-categories') || '').split(',').filter(Boolean);
          var hit = cats.some(function (c) { return activeCats[c]; });
          if (!hit) return false;
        }
        // text query (all terms must appear)
        if (query) {
          var text = card.getAttribute('data-search') || '';
          var terms = query.split(/\s+/).filter(Boolean);
          if (!terms.every(function (t) { return text.indexOf(t) !== -1; })) return false;
        }
        return true;
      }

      function isSeriesCard(card) { return card.getAttribute('data-series-card') === '1'; }

      // ---- Section header builders ----
      function seriesHeader(groupId) {
        var g = groupsMeta[groupId];
        var head = document.createElement('header');
        head.className = 'group-header';
        var logo = g.logo
          ? '<img src="' + g.logo + '" alt="" loading="lazy" decoding="async" />'
          : '<span class="group-logo-fallback">' + MIC + '</span>';
        var links = '';
        if (g.website) links += '<a class="group-site" href="' + g.website + '" target="_blank" rel="noopener noreferrer">Visit site ↗</a>';
        (g.donateLinks || []).forEach(function (d) {
          links += '<a class="group-donate" href="' + d.url + '" target="_blank" rel="noopener noreferrer"><span class="group-donate-icon">' + HEART + '</span>' + d.label + '</a>';
        });
        head.innerHTML =
          '<div class="group-logo" aria-hidden="true">' + logo + '</div>' +
          '<div class="group-meta">' +
            '<h2>' + g.name + '</h2>' +
            (g.host ? '<p class="group-host">' + g.host + '</p>' : '') +
            '<p class="group-desc">' + g.description + '</p>' +
            (links ? '<div class="group-links">' + links + '</div>' : '') +
          '</div>';
        return head;
      }
      function simpleHeader(label, blurb, count) {
        var head = document.createElement('header');
        head.className = 'simple-header';
        head.innerHTML = '<h2>' + label + ' <span class="head-count">' + count + '</span></h2>' +
          (blurb ? '<p class="head-blurb">' + blurb + '</p>' : '');
        return head;
      }

      function makeSection(headerEl, cards) {
        var sec = document.createElement('div');
        sec.className = 'iv-group';
        sec.appendChild(headerEl);
        var grid = document.createElement('div');
        grid.className = 'interview-grid';
        cards.forEach(function (c) { grid.appendChild(c.cloneNode(true)); });
        sec.appendChild(grid);
        return sec;
      }

      function render() {
        results.innerHTML = '';
        var visible = allCards.filter(matches);
        // Series cards only make sense in the Series view
        var contentVisible = visible.filter(function (c) { return groupBy === 'series' || !isSeriesCard(c); });
        var realCount = visible.filter(function (c) { return !isSeriesCard(c); }).length;

        if (groupBy === 'series') {
          groupOrder.forEach(function (gid) {
            var cs = contentVisible.filter(function (c) { return c.getAttribute('data-group') === gid; });
            if (cs.length) results.appendChild(makeSection(seriesHeader(gid), cs));
          });
        } else if (groupBy === 'category') {
          categoryList.forEach(function (cat) {
            var cs = contentVisible.filter(function (c) {
              return (c.getAttribute('data-categories') || '').split(',').indexOf(cat.id) !== -1;
            });
            if (cs.length) results.appendChild(makeSection(simpleHeader(cat.label, cat.blurb, cs.length), cs));
          });
        } else { // artist
          var buckets = {};
          contentVisible.forEach(function (c) {
            var key = c.getAttribute('data-guest') || '—';
            (buckets[key] = buckets[key] || []).push(c);
          });
          Object.keys(buckets).sort(function (a, b) {
            return a.localeCompare(b, undefined, { sensitivity: 'base' });
          }).forEach(function (name) {
            results.appendChild(makeSection(simpleHeader(name, '', buckets[name].length), buckets[name]));
          });
        }

        var filtering = query || format !== 'all' || anyKey(activeCats) || anyKey(activeSeries);
        if (countEl) {
          countEl.hidden = !filtering;
          countEl.textContent = realCount + (realCount === 1 ? ' interview' : ' interviews') + ' of ' + totalCount;
        }
        if (noResults) noResults.hidden = realCount !== 0;
        if (clearBtn) clearBtn.hidden = !query;
      }

      // ---- Wire controls ----
      searchInput.addEventListener('input', function () {
        query = searchInput.value.trim().toLowerCase();
        render();
      });
      if (clearBtn) clearBtn.addEventListener('click', function () {
        searchInput.value = ''; query = ''; searchInput.focus(); render();
      });

      document.querySelectorAll('[data-format]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          format = btn.getAttribute('data-format');
          document.querySelectorAll('[data-format]').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
          render();
        });
      });
      document.querySelectorAll('[data-groupby]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          groupBy = btn.getAttribute('data-groupby');
          document.querySelectorAll('[data-groupby]').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
          render();
        });
      });
      document.querySelectorAll('[data-filter-category]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-filter-category');
          activeCats[id] = !activeCats[id];
          btn.classList.toggle('is-active', !!activeCats[id]);
          render();
        });
      });
      document.querySelectorAll('[data-filter-series]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-filter-series');
          activeSeries[id] = !activeSeries[id];
          btn.classList.toggle('is-active', !!activeSeries[id]);
          render();
        });
      });
      document.querySelectorAll('[data-reset]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          query = ''; format = 'all'; activeCats = {}; activeSeries = {};
          searchInput.value = '';
          document.querySelectorAll('[data-format]').forEach(function (b) { b.classList.toggle('is-active', b.getAttribute('data-format') === 'all'); });
          document.querySelectorAll('[data-filter-category].is-active, [data-filter-series].is-active').forEach(function (b) { b.classList.remove('is-active'); });
          render();
        });
      });

      render();
    })();
  </script>
</BaseLayout>

<style>
  /* ===== Controls ===== */
  .iv-controls {
    position: sticky;
    top: var(--header-height);
    z-index: 50;
    background: white;
    border-bottom: 1px solid var(--color-slate-200);
    padding: 0.75rem 0;
  }
  .controls-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .controls-row + .controls-row { margin-top: 0.5rem; }
  .controls-top { flex-wrap: wrap; }
  .controls-label {
    flex-shrink: 0;
    width: 4.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-slate-400);
  }

  .search-wrap { position: relative; flex: 1 1 260px; min-width: 200px; }
  .search-icon {
    position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%);
    width: 1.05rem; height: 1.05rem; color: var(--color-slate-400); pointer-events: none;
  }
  .search-input {
    width: 100%;
    border: 1px solid var(--color-slate-300);
    border-radius: 999px;
    padding: 0.6rem 2.2rem 0.6rem 2.5rem;
    font-family: var(--font-sans); font-size: 0.95rem; color: var(--color-slate-700); background: white;
  }
  .search-input:focus { outline: none; border-color: var(--color-orange-400); box-shadow: 0 0 0 3px var(--color-orange-100); }
  .search-clear {
    position: absolute; right: 0.6rem; top: 50%; transform: translateY(-50%);
    width: 1.5rem; height: 1.5rem; border: none; background: var(--color-slate-100);
    border-radius: 999px; color: var(--color-slate-500); font-size: 1.1rem; line-height: 1; cursor: pointer;
  }
  .search-clear:hover { background: var(--color-slate-200); color: var(--color-slate-700); }

  .format-filters { display: flex; gap: 0.35rem; flex-shrink: 0; }
  .pill {
    padding: 0.45rem 0.9rem; border: 1px solid var(--color-slate-300); border-radius: 999px; background: white;
    font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600; color: var(--color-slate-600);
    cursor: pointer; transition: all 0.15s;
  }
  .pill:hover { border-color: var(--color-orange-400); color: var(--color-orange-700); }
  .pill.is-active { background: var(--color-primary); border-color: var(--color-primary); color: white; }

  .chip-row {
    display: flex; gap: 0.4rem; flex-wrap: wrap; flex: 1;
  }
  .chip {
    padding: 0.3rem 0.8rem; border: 1px solid var(--color-slate-200); border-radius: 999px; background: white;
    font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600; color: var(--color-slate-500);
    cursor: pointer; transition: all 0.15s;
  }
  .chip:hover { border-color: var(--color-orange-400); color: var(--color-orange-700); background: var(--color-orange-50); }
  .chip.is-active {
    background: var(--color-orange-100); border-color: var(--color-orange-300); color: var(--color-orange-700);
  }
  .controls-groupby { margin-top: 0.65rem; padding-top: 0.65rem; border-top: 1px dashed var(--color-slate-200); }

  /* ===== Sections ===== */
  .iv-section { padding: 1.75rem 0 3rem; }
  .result-count { margin: 0 0 1.25rem; font-size: 0.9rem; color: var(--color-slate-500); }

  .iv-group + .iv-group {
    margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--color-slate-200);
  }

  .group-header { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1.5rem; }
  .group-logo {
    flex-shrink: 0; width: 56px; height: 56px; border-radius: var(--radius-md); overflow: hidden;
    background: var(--color-slate-100); display: flex; align-items: center; justify-content: center; color: var(--color-slate-400);
  }
  .group-logo :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .group-logo :global(.group-logo-fallback svg) { width: 1.6rem; height: 1.6rem; }
  .group-meta h2 { margin: 0 0 0.1rem; font-size: 1.45rem; }
  .group-host { margin: 0 0 0.5rem; font-size: 0.85rem; font-style: italic; color: var(--color-orange-600); }
  .group-desc { margin: 0 0 0.85rem; color: var(--color-slate-600); font-size: 0.95rem; line-height: 1.6; max-width: 70ch; }
  .group-links { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
  .group-site { font-size: 0.85rem; font-weight: 600; color: var(--color-primary); }
  .group-donate {
    display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; font-weight: 600;
    color: var(--color-orange-700); background: var(--color-orange-50); border: 1px solid var(--color-orange-200);
    border-radius: 999px; padding: 0.3rem 0.8rem; transition: all 0.15s;
  }
  .group-donate:hover { background: var(--color-orange-100); border-color: var(--color-orange-400); }
  .group-donate :global(.group-donate-icon svg) { width: 0.95rem; height: 0.95rem; }

  .simple-header { margin-bottom: 1.25rem; }
  .simple-header h2 { margin: 0 0 0.15rem; font-size: 1.4rem; }
  .head-count {
    font-size: 0.8rem; font-weight: 600; color: var(--color-slate-400); vertical-align: middle;
    background: var(--color-slate-100); border-radius: 999px; padding: 0.05rem 0.5rem; margin-left: 0.35rem;
  }
  .head-blurb { margin: 0; color: var(--color-slate-500); font-size: 0.9rem; }

  /* ===== Cards ===== */
  .interview-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
  .interview-card {
    display: flex; flex-direction: column; background: white; border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg); overflow: hidden; transition: all 0.2s;
  }
  .interview-card:hover { border-color: var(--color-orange-400); box-shadow: var(--shadow-md); transform: translateY(-2px); }

  .card-media {
    position: relative; display: block; aspect-ratio: 16 / 9; background: var(--color-slate-100);
    color: var(--color-slate-400); overflow: hidden;
  }
  .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-media-fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .card-media-fallback :global(svg) { width: 2.4rem; height: 2.4rem; }
  .format-badge {
    position: absolute; top: 0.6rem; left: 0.6rem; font-size: 0.66rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: white; padding: 0.15rem 0.5rem; border-radius: 999px;
  }
  .format-badge--video { background: rgba(15, 23, 42, 0.82); }
  .format-badge--podcast { background: var(--color-orange-600); }

  .card-body { display: flex; flex-direction: column; padding: 0.9rem 1.1rem 1.1rem; flex: 1; }
