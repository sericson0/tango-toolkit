---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolIcon from '../../../components/dancer/ToolIcon.astro';
import DrillLibrary from '../../../components/dancer/DrillLibrary.astro';
import { getSectionTopics, topicHref } from '../../../data/dancerContent';
import { dancerResources } from '../../../data/dancerResources';
import {
  visibleDancerSections,
  type DancerSection,
} from '../../../data/dancerSections';

export function getStaticPaths() {
  return visibleDancerSections.map((section) => ({
    params: { section: section.id },
    props: { section },
  }));
}

interface Props {
  section: DancerSection;
}

const { section } = Astro.props;
const topics = await getSectionTopics(section.id);
const isPath = section.hubLayout === 'path';
const others = visibleDancerSections.filter((s) => s.id !== section.id);
const extras = section.extras ?? [];
// A section can carry a library instead of topics — only then is it "empty".
const isEmpty = topics.length === 0 && extras.length === 0 && !section.showDrillLibrary;

const LEVEL_LABELS: Record<string, string> = {
  new: 'New dancers',
  developing: 'Once you have the basics',
  all: '',
};
---

<BaseLayout title={section.title} description={section.lead}>
  <section class="hub-hero">
    <div class="container">
      <a href="/dancer/" class="back-link">&larr; Dancer Toolkit</a>
      <div class="hub-hero-main">
        <span class="hub-hero-icon" aria-hidden="true">
          <ToolIcon name={section.tool} size={34} />
        </span>
        <div>
          <h1>{section.title}</h1>
          <p class="lead">{section.lead}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="hub-body">
    <div class="container">
      {isEmpty ? (
        <p class="callout callout-warning hub-empty">
          <strong>Being written</strong>
          There is nothing here yet. If there is something you want covered first,
          say so at <a href="mailto:tangotoolkit@gmail.com">tangotoolkit@gmail.com</a>.
        </p>
      ) : topics.length === 0 ? null : isPath ? (
        <ol class="hub-path">
          {topics.map((topic, i) => (
            <li>
              <a href={topicHref(topic)} class="hub-path-card">
                <span class="hub-path-num" aria-hidden="true">{i + 1}</span>
                <span class="hub-path-body">
                  <span class="hub-path-title">{topic.data.title}</span>
                  <span class="hub-path-summary">{topic.data.summary}</span>
                </span>
                <span class="hub-path-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <div class="hub-grid">
          {topics.map((topic) => (
            <a href={topicHref(topic)} class="hub-card">
              <span class="hub-card-icon" aria-hidden="true">
                <ToolIcon name={topic.data.tool} size={22} />
              </span>
              <h2>{topic.data.title}</h2>
              <p>{topic.data.summary}</p>
              <span class="hub-card-foot">
                {LEVEL_LABELS[topic.data.level] && (
                  <span class="hub-card-chip">{LEVEL_LABELS[topic.data.level]}</span>
                )}
                <span class="hub-card-cta">Open &rarr;</span>
              </span>
            </a>
          ))}
        </div>
      )}

      {extras.length > 0 && (
        <ul class="hub-extras">
          {extras.map((extra) => (
            <li>
              <a href={extra.href} class="hub-extra">
                <span class="hub-extra-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 6 2 18 2 18 9" />
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                    <rect x="6" y="14" width="12" height="8" />
                  </svg>
                </span>
                <span class="hub-extra-body">
                  <span class="hub-extra-title">
                    {extra.title}
                    {extra.badge && <span class="hub-extra-badge">{extra.badge}</span>}
                  </span>
                  <span class="hub-extra-summary">{extra.summary}</span>
                </span>
                <span class="hub-extra-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {section.showDrillLibrary && <DrillLibrary />}

      {section.showResourceLibrary && dancerResources.length > 0 && (
        <section class="hub-library">
          <h2>From the wider tango world</h2>
          <p class="hub-library-lead">
            Guides and materials made by other teachers and dancers. Know something that
            belongs here? <a href="mailto:tangotoolkit@gmail.com">Tell us.</a>
          </p>
          <div class="hub-library-list">
            {dancerResources.map((resource) => (
              <article class="hub-resource">
                {resource.image && (
                  <div class="hub-resource-media">
                    <img src={resource.image} alt="" loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="hub-resource-body">
                  <h3>{resource.title}</h3>
                  <span class="hub-resource-author">by {resource.author}</span>
                  <p>{resource.description}</p>
                  <div class="hub-resource-actions">
                    {resource.downloadUrl && (
                      <a
                        href={resource.downloadUrl}
                        class="btn btn-primary btn-sm"
                        target={resource.external ? '_blank' : undefined}
                        rel={resource.external ? 'noopener noreferrer' : undefined}
                      >{resource.downloadLabel ?? 'Download'}</a>
                    )}
                    <a
                      href={resource.url}
                      class="hub-resource-cta"
                      target={resource.external ? '_blank' : undefined}
                      rel={resource.external ? 'noopener noreferrer' : undefined}
                    >{resource.external ? 'Visit site ↗' : 'Learn more →'}</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <nav class="hub-others" aria-label="Other sections">
        <h2>Elsewhere in the dancer toolkit</h2>
        <div class="hub-others-row">
          {others.map((other) => (
            <a href={`/dancer/${other.id}/`} class="hub-other">
              <ToolIcon name={other.tool} size={18} />
              <span>
                <strong>{other.title}</strong>
                <em>{other.blurb}</em>
              </span>
            </a>
          ))}
        </div>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .hub-hero {
    padding: 2.5rem 0;
    background: linear-gradient(135deg, var(--color-slate-50) 0%, white 100%);
    border-bottom: 1px solid var(--color-slate-200);
  }

  .hub-hero-main {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .hub-hero-icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    background: white;
    border: 1px solid var(--color-orange-200);
    color: var(--color-orange-600);
    box-shadow: var(--shadow-sm);
  }

  .hub-hero h1 { margin: 0 0 0.4rem; }

  .hub-hero .lead { max-width: 55ch; }

  .hub-body { padding: 2.5rem 0 1rem; }

  .hub-empty { max-width: 44rem; }

  .hub-empty a {
    color: var(--color-link);
    text-decoration: underline;
  }

  /* ===== Grid layout ===== */
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.1rem;
  }

  .hub-card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .hub-card:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    color: inherit;
  }

  .hub-card-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.85rem;
    border-radius: var(--radius-md);
    background: var(--color-orange-50);
    color: var(--color-orange-600);
  }

  .hub-card:hover .hub-card-icon {
    background: var(--color-primary);
    color: white;
  }

  .hub-card h2 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .hub-card p {
    margin: 0 0 1rem;
    flex: 1;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-slate-600);
  }

  .hub-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .hub-card-chip {
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: var(--color-slate-100);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-slate-500);
  }

  .hub-card-cta {
    margin-left: auto;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  /* ===== Path layout ===== */
  .hub-path {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 46rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hub-path-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .hub-path-card:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-sm);
    color: inherit;
  }

  .hub-path-num {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-label-bg);
    border: 1px solid var(--color-slate-300);
    color: var(--color-label-text);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .hub-path-card:hover .hub-path-num {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .hub-path-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }

  .hub-path-title {
    font-weight: 600;
    color: var(--color-slate-800);
  }

  .hub-path-summary {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-slate-600);
  }

  .hub-path-arrow {
    flex-shrink: 0;
    color: var(--color-primary);
    font-weight: 600;
  }

  /* ===== Extras (printables, tools) ===== */
  .hub-extras {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    max-width: 46rem;
  }

  .hub-extra {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--color-orange-50);
    border: 1px dashed var(--color-orange-300);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s;
  }

  .hub-extra:hover {
    border-color: var(--color-orange-500);
    background: var(--color-orange-100);
    color: inherit;
  }

  .hub-extra-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    color: var(--color-orange-600);
  }

  .hub-extra-icon svg { width: 1.35rem; height: 1.35rem; }

  .hub-extra-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }

  .hub-extra-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-weight: 600;
    color: var(--color-slate-800);
  }

  .hub-extra-badge {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--color-slate-600);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: white;
  }

  .hub-extra-summary {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-slate-600);
  }

  .hub-extra-arrow {
    flex-shrink: 0;
    color: var(--color-orange-600);
    font-weight: 600;
  }

  /* ===== Shared resource library ===== */
  .hub-library {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-slate-200);
  }

  .hub-library h2 {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
  }

  .hub-library-lead {
    margin: 0 0 1.5rem;
    max-width: 55ch;
    color: var(--color-slate-600);
    font-size: 0.95rem;
  }

  .hub-library-lead a { text-decoration: underline; }

  .hub-library-list {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
  }

  .hub-resource {
    position: relative;
    display: flex;
    gap: 1.25rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .hub-resource:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
  }

  .hub-resource-media {
    flex-shrink: 0;
    width: 140px;
    background: var(--color-slate-100);
  }

  .hub-resource-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hub-resource-body {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.25rem 1.1rem 0;
  }

  .hub-resource-body h3 {
    margin: 0 0 0.1rem;
    font-size: 1.1rem;
  }

  .hub-resource-author {
    margin-bottom: 0.55rem;
    font-size: 0.8rem;
    color: var(--color-slate-500);
  }

  .hub-resource-body p {
    margin: 0 0 1rem;
    flex: 1;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-slate-600);
  }

  .hub-resource-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .hub-resource-actions .btn-sm {
    position: relative;
    z-index: 1;
    padding: 0.35rem 0.85rem;
    font-size: 0.82rem;
  }

  .hub-resource-cta {
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .hub-resource-cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (max-width: 520px) {
    .hub-resource { flex-direction: column; }
    .hub-resource-media { width: 100%; height: 160px; }
    .hub-resource-body { padding: 0 1.25rem 1.25rem; }
  }

  /* ===== Other sections ===== */
  .hub-others {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-slate-200);
  }

  .hub-others h2 {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-slate-400);
  }

  .hub-others-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
  }

  .hub-other {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    background: white;
    text-decoration: none;
    color: var(--color-slate-500);
    transition: border-color 0.2s;
  }

  .hub-other:hover { border-color: var(--color-orange-400); }

  .hub-other span {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .hub-other strong {
    font-size: 0.92rem;
    color: var(--color-slate-800);
  }

  .hub-other em {
    font-style: normal;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--color-slate-500);
  }

  @media (max-width: 560px) {
    .hub-hero-main { flex-direction: column; gap: 1rem; }
  }
</style>
