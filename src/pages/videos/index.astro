---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { dancerVideoCategories, videosByCategory } from '../../data/dancerVideos';
import { interviews } from '../../data/interviews';

// Inline icon (Feather "mic", MIT)
const MIC_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>';

// Round down to the nearest ten so the "N+" phrasing stays honest as entries are added.
const interviewCount = Math.floor(interviews.filter((iv) => !iv.seriesCard).length / 10) * 10;
---

<BaseLayout title="Videos" description="Tango videos — performances, lessons, and interviews with dancers, teachers, and maestros.">
  <PageHero
    title="Videos"
    lead="Performances, lessons, and interviews from the world of tango."
  />

  <section class="videos-section">
    <div class="container">
      {dancerVideoCategories.map((category) => {
        const videos = videosByCategory(category.id);
        return (
          <div class="video-category" id={category.id}>
            <h2 class="section-heading">{category.title}</h2>
            <p class="section-blurb">{category.blurb}</p>

            {videos.length > 0 ? (
              <div class="videos-grid">
                {videos.map((video) => (
                  <article class="video-card">
                    <VideoEmbed url={video.url} title={video.title} />
                    <div class="video-card-body">
                      <h3>{video.title}</h3>
                      {video.author && <p class="video-card-author">{video.author}</p>}
                      {video.description && <p class="video-card-desc">{video.description}</p>}
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty-state">
                {category.title} are on the way &mdash; this library is just getting started.
                <a href="/#subscribe">Subscribe</a> to hear when new videos land.
              </p>
            )}
          </div>
        );
      })}

      <div class="video-category" id="interviews">
        <h2 class="section-heading">Interviews</h2>
        <p class="section-blurb">A searchable library of conversations with the dancers, musicians, and maestros of tango.</p>
        <a href="/videos/interviews/" class="interview-link-card">
          <div class="interview-link-icon" set:html={MIC_SVG}></div>
          <div class="interview-link-body">
            <h3>Browse the interview library</h3>
            <p>{interviewCount}+ video and podcast conversations &mdash; browse by series or category.</p>
            <span class="card-cta">Explore interviews &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .videos-section {
    padding: 3rem 0;
  }

  .video-category {
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  .video-category + .video-category {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-slate-200);
  }

  .section-heading {
    margin: 0 0 0.35rem;
    font-size: 1.6rem;
  }

  .section-blurb {
    margin: 0 0 1.5rem;
    color: var(--color-slate-600);
    max-width: 60ch;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .video-card {
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .video-card :global(.video-embed) {
    margin: 0;
    border-radius: 0;
  }

  .video-card-body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .video-card h3 {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
  }

  .video-card-author {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-orange-600);
  }

  .video-card-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-slate-600);
    line-height: 1.6;
  }

  .empty-state {
    margin: 0;
    padding: 1.5rem 1.75rem;
    background: var(--color-slate-50);
    border: 1px dashed var(--color-slate-300);
    border-radius: var(--radius-lg);
    color: var(--color-slate-600);
    max-width: 60ch;
  }

  .empty-state a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Interviews entry point — compact card */
  .interview-link-card {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    max-width: 460px;
    padding: 1.1rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .interview-link-card:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .interview-link-icon {
    flex-shrink: 0;
    color: var(--color-orange-500);
  }

  .interview-link-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .interview-link-card h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }

  .interview-link-body p {
    margin: 0 0 0.5rem;
    color: var(--color-slate-600);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .card-cta {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.85rem;
  }
</style>
