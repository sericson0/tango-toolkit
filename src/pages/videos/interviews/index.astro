---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import {
  interviews,
  interviewGroups,
  interviewCategories,
  getInterviewGroup,
  getInterviewCategory,
  interviewThumbnail,
  interviewSource,
  interviewTitle,
  interviewCta,
  interviewBlurb,
  interviewLanguage,
  languageLabel,
  guestNames,
} from '../../../data/interviews';

// Inline icons (Feather, MIT)
const ICON = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const MIC_SVG = `<svg ${ICON}><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>`;
const VIDEO_SVG = `<svg ${ICON}><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`;
const SLIDERS_SVG = `<svg ${ICON}><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>`;

// Render-ready view for every interview.
const cards = interviews.map((iv) => {
  const group = getInterviewGroup(iv.groupId)!;
  const catLabels = iv.categories.map((c) => getInterviewCategory(c)?.label ?? c);
  const language = interviewLanguage(iv, group);
  const searchText = [
    interviewTitle(iv),
    iv.guest,
    ...guestNames(iv.guest),
    group.name,
    group.host ?? '',
    ...catLabels,
    interviewSource(iv),
    iv.format,
    languageLabel(language),
  ].join(' ').toLowerCase();
  return {
    iv,
    group,
    title: interviewTitle(iv),
    blurb: interviewBlurb(iv, group),
    thumb: interviewThumbnail(iv, group),
    source: interviewSource(iv),
    catLabels,
    language,
    searchText,
  };
});

// Data the client script needs to build section headers on the fly.
const groupsMeta = Object.fromEntries(
  interviewGroups.map((g) => [g.id, {
    name: g.name,
    host: g.host ?? '',
    description: g.description,
    logo: g.logo ?? '',
    website: g.website ?? '',
    donateLinks: g.donateLinks ?? [],
  }])
);
const groupOrder = interviewGroups.map((g) => g.id);
const categoryList = interviewCategories.map((c) => ({ id: c.id, label: c.label, blurb: c.blurb }));
const totalCount = cards.filter((c) => !c.iv.seriesCard).length;

// Compact data for the "Surprise me" picker (real episodes only).
const suggestPool = cards
  .filter((c) => !c.iv.seriesCard)
  .map((c) => ({
    id: c.iv.id,
    title: c.title,
    url: c.iv.url,
    format: c.iv.format,
    cta: interviewCta(c.iv),
    language: c.language,
    categories: c.iv.categories,
    group: c.group.name,
    thumb: c.thumb ?? '',
  }));
---

<BaseLayout
  title="Tango Interviews"
  description="A searchable library of tango interviews — video and podcast conversations with dancers, teachers, musicians, and maestros. Browse by series or category, and support the groups that make them."
>
  <PageHero
    title="Interviews"
    lead="A searchable library of conversations with the dancers, musicians, and maestros of tango. Browse by series or category."
    backHref="/videos/"
    backText="Back to Videos"
    compact={true}
    leadWide={true}
  />

  <!-- ===== Surprise-me bar ===== -->
  <div class="suggest-bar">
    <div class="container">
      <span class="suggest-hint">Not sure what to watch?</span>
      <button type="button" class="suggest-btn" data-suggest-open>Surprise me</button>
    </div>
  </div>

  <!-- ===== Controls (sticky, compact) ===== -->
  <div class="iv-controls">
    <div class="container">
      <div class="controls-bar">
        <div class="search-wrap">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" class="search-input" data-search placeholder="Search interviews…" aria-label="Search interviews" autocomplete="off" />
          <button type="button" class="search-clear" data-search-clear aria-label="Clear search" hidden>&times;</button>
        </div>

        <button type="button" class="filters-toggle" data-filters-toggle aria-expanded="false" aria-controls="iv-filters">
          <span class="filters-toggle-icon" set:html={SLIDERS_SVG} /> Filters
        </button>

        <div class="filters-wrap" id="iv-filters" data-filters>
          <select class="iv-select" data-format aria-label="Filter by format">
            <option value="all">All formats</option>
            <option value="video">Video</option>
            <option value="podcast">Podcast</option>
          </select>

          <select class="iv-select" data-filter-category aria-label="Filter by topic">
            <option value="">All topics</option>
            {interviewCategories.map((c) => (
              <option value={c.id}>{c.label}</option>
            ))}
          </select>

          <select class="iv-select" data-filter-series aria-label="Filter by series">
            <option value="">All series</option>
            {interviewGroups.map((g) => (
              <option value={g.id}>{g.name}</option>
            ))}
          </select>

          <label class="iv-groupby">
            <span>Group by</span>
            <select class="iv-select" data-groupby aria-label="Group results by">
              <option value="series">Series</option>
              <option value="category">Category</option>
            </select>
          </label>

          <button type="button" class="iv-starred" data-starred-toggle aria-pressed="false" title="Show only interviews you starred">
            <svg class="iv-starred-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            Starred
          </button>
        </div>

        <button type="button" class="iv-reset" data-reset hidden>Reset filters</button>
        <span class="result-count" data-result-count aria-live="polite"></span>
      </div>
    </div>
  </div>

  <section class="iv-section">
    <div class="container">
      <!-- Card pool — hidden source; JS clones from here into #iv-results grouped per the view -->
      <div id="iv-pool" hidden>
        {cards.map(({ iv, group, title, blurb, thumb, source, language, searchText }) => (
          <article
            class="interview-card"
            data-card
            data-id={iv.id}
            data-group={iv.groupId}
            data-format={iv.format}
            data-categories={iv.categories.join(',')}
            data-language={language}
            data-series-card={iv.seriesCard ? '1' : ''}
            data-search={searchText}
          >
            <div class="card-thumb">
              {thumb ? (
                <img src={thumb} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="card-thumb-fallback" set:html={iv.format === 'podcast' ? MIC_SVG : VIDEO_SVG} />
              )}
            </div>
            <div class="card-body">
              <div class="card-eyebrow">
                <span class="card-group-name">{group.name}</span>
                <span class={`card-lang card-lang--${language}`}>{languageLabel(language)}</span>
              </div>
              <h3 class="card-title">{title}</h3>
              {blurb && <p class="card-desc">{blurb}</p>}
              <div class="card-foot">
                {source && <span class="card-source">{source}</span>}
                <div class="card-actions">
                  <button type="button" class="iv-like" data-like-id={iv.id} aria-pressed="false" aria-label={`Star ${title}`} title="Star this interview">
                    <svg class="iv-like-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <span class="iv-like-count" data-like-count aria-hidden="true"></span>
                  </button>
                  <a class="card-cta" href={iv.url} target="_blank" rel="noopener noreferrer" aria-label={`${iv.seriesCard ? 'Browse' : 'Open'}: ${title}`}>{interviewCta(iv)} ↗</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div id="iv-results"></div>

      <p class="no-results" data-no-results hidden>
        No interviews match your filters.
        <button type="button" class="linkish" data-reset>Clear all filters</button>.
      </p>

      <div class="callout callout-tip suggest">
        <strong>Know an interview series we should add?</strong>
        <p>
          We&rsquo;re growing this library. If you make tango interviews &mdash; or love a series that belongs here &mdash;
          email <a href="mailto:tangotoolkit@gmail.com">tangotoolkit@gmail.com</a> with the link (and a donation page, if there is one).
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Surprise-me modal ===== -->
  <div class="sg-overlay" data-suggest-modal>
    <div class="sg-modal" role="dialog" aria-modal="true" aria-labelledby="sg-title" tabindex="-1">
      <button type="button" class="sg-close" data-suggest-close aria-label="Close">&times;</button>
      <h2 id="sg-title">Find me an interview</h2>
      <p class="sg-sub">Pick a language and any topics, and we&rsquo;ll surprise you with one you haven&rsquo;t seen.</p>

      <fieldset class="sg-field">
        <legend>Language</legend>
        <div class="sg-options">
          <label class="sg-check"><input type="checkbox" data-sg-lang value="english" checked /> English</label>
          <label class="sg-check"><input type="checkbox" data-sg-lang value="spanish" checked /> Spanish</label>
        </div>
      </fieldset>

      <fieldset class="sg-field">
        <legend>Topics <span class="sg-optional">(optional)</span></legend>
        <div class="sg-options">
          {interviewCategories.map((c) => (
            <label class="sg-check"><input type="checkbox" data-sg-cat value={c.id} /> {c.label}</label>
          ))}
        </div>
      </fieldset>

      <button type="button" class="sg-go" data-suggest-go>Surprise me</button>

      <div class="sg-result" data-suggest-result hidden></div>
      <p class="sg-empty" data-suggest-empty hidden>No interviews match those filters &mdash; try adding a language or removing a topic.</p>
    </div>
  </div>

  <script is:inline define:vars={{ groupsMeta, groupOrder, categoryList, totalCount, suggestPool }}>
    (function () {
      var HEART = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';
      var CHEV_LEFT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>';
      var CHEV_RIGHT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>';

      var pool = document.getElementById('iv-pool');
      var results = document.getElementById('iv-results');
      if (!pool || !results) return;
      var allCards = Array.prototype.slice.call(pool.querySelectorAll('[data-card]'));

      // State
      var query = '';
      var format = 'all';
      var groupBy = 'series';
      var category = '';
      var series = '';
      var starredOnly = false;

      var searchInput = document.querySelector('[data-search]');
      var clearBtn = document.querySelector('[data-search-clear]');
      var countEl = document.querySelector('[data-result-count]');
      var noResults = document.querySelector('[data-no-results]');
      var formatSel = document.querySelector('[data-format]');
      var catSel = document.querySelector('[data-filter-category]');
      var seriesSel = document.querySelector('[data-filter-series]');
      var groupbySel = document.querySelector('[data-groupby]');
      var starredBtn = document.querySelector('[data-starred-toggle]');
      var toolbarReset = document.querySelector('.iv-reset');
      var filtersToggle = document.querySelector('[data-filters-toggle]');
      var filtersWrap = document.querySelector('[data-filters]');

      function matches(card) {
        if (format !== 'all' && card.getAttribute('data-format') !== format) return false;
        if (series && card.getAttribute('data-group') !== series) return false;
        if (starredOnly && liked.indexOf(card.getAttribute('data-id')) === -1) return false;
        if (category) {
          var cats = (card.getAttribute('data-categories') || '').split(',').filter(Boolean);
          if (cats.indexOf(category) === -1) return false;
        }
        if (query) {
          var text = card.getAttribute('data-search') || '';
          var terms = query.split(/\s+/).filter(Boolean);
          if (!terms.every(function (t) { return text.indexOf(t) !== -1; })) return false;
        }
        return true;
      }
      function isSeriesCard(card) { return card.getAttribute('data-series-card') === '1'; }

      // ---- Section header builders ----
      function seriesHeader(groupId, count) {
        var g = groupsMeta[groupId];
        var head = document.createElement('header');
        head.className = 'group-header';
        // Only render a logo box when the series actually has a logo — no placeholder otherwise.
        var logoHtml = g.logo
          ? '<div class="group-logo" aria-hidden="true"><img src="' + g.logo + '" alt="" loading="lazy" decoding="async" /></div>'
          : '';
        var links = '';
        if (g.website) links += '<a class="group-site" href="' + g.website + '" target="_blank" rel="noopener noreferrer">Visit site ↗</a>';
        (g.donateLinks || []).forEach(function (d) {
          links += '<a class="group-donate" href="' + d.url + '" target="_blank" rel="noopener noreferrer"><span class="group-donate-icon">' + HEART + '</span>' + d.label + '</a>';
        });
        head.innerHTML =
          logoHtml +
          '<div class="group-meta">' +
            '<div class="group-titlebar">' +
              '<h2>' + g.name + '</h2>' +
              '<span class="head-count">' + count + '</span>' +
              (g.host ? '<span class="group-host">' + g.host + '</span>' : '') +
              (links ? '<div class="group-links">' + links + '</div>' : '') +
            '</div>' +
            (g.description ? '<p class="group-desc">' + g.description + '</p>' : '') +
          '</div>';
        return head;
      }
      function simpleHeader(label, blurb, count) {
        var head = document.createElement('header');
        head.className = 'simple-header';
        head.innerHTML = '<h2>' + label + '</h2><span class="head-count">' + count + '</span>' +
          (blurb ? '<span class="head-blurb">' + blurb + '</span>' : '');
        return head;
      }

      // ---- Carousel (single-row horizontal shelf) ----
      function makeSection(headerEl, cards) {
        var sec = document.createElement('div');
        sec.className = 'iv-group';
        sec.appendChild(headerEl);

        var wrap = document.createElement('div');
        wrap.className = 'carousel';
        var prev = document.createElement('button');
        prev.type = 'button';
        prev.className = 'carousel-arrow carousel-prev';
        prev.setAttribute('aria-label', 'Scroll left');
        prev.innerHTML = CHEV_LEFT;
        var track = document.createElement('div');
        track.className = 'carousel-track';
        cards.forEach(function (c) { track.appendChild(c.cloneNode(true)); });
        var next = document.createElement('button');
        next.type = 'button';
        next.className = 'carousel-arrow carousel-next';
        next.setAttribute('aria-label', 'Scroll right');
        next.innerHTML = CHEV_RIGHT;
        wrap.appendChild(prev);
        wrap.appendChild(track);
        wrap.appendChild(next);
        sec.appendChild(wrap);
        return sec;
      }

      function updateArrows(wrap) {
        var track = wrap.querySelector('.carousel-track');
        var prev = wrap.querySelector('.carousel-prev');
        var next = wrap.querySelector('.carousel-next');
        if (!track || !prev || !next) return;
        var max = track.scrollWidth - track.clientWidth - 1;
        var scrollable = track.scrollWidth > track.clientWidth + 1;
        wrap.classList.toggle('is-scrollable', scrollable);
        prev.disabled = !scrollable || track.scrollLeft <= 0;
        next.disabled = !scrollable || track.scrollLeft >= max;
      }
      function wireCarousel(wrap) {
        var track = wrap.querySelector('.carousel-track');
        var prev = wrap.querySelector('.carousel-prev');
        var next = wrap.querySelector('.carousel-next');
        if (!track || !prev || !next) return;
        function page(dir) {
          track.scrollBy({ left: dir * Math.max(track.clientWidth * 0.85, 160), behavior: 'smooth' });
        }
        prev.addEventListener('click', function () { page(-1); });
        next.addEventListener('click', function () { page(1); });
        track.addEventListener('scroll', function () { updateArrows(wrap); });
        updateArrows(wrap);
      }

      // ---- Keep the URL in sync so filtered views can be shared/bookmarked ----
      function syncUrl() {
        var p = new URLSearchParams();
        if (query) p.set('q', searchInput.value.trim());
        if (format !== 'all') p.set('format', format);
        if (category) p.set('topic', category);
        if (series) p.set('series', series);
        if (groupBy !== 'series') p.set('view', groupBy);
        if (starredOnly) p.set('starred', '1');
        var qs = p.toString();
        history.replaceState(null, '', qs ? '?' + qs : location.pathname);
      }

      function render() {
        results.innerHTML = '';
        var visible = allCards.filter(matches);
        // Series cards only make sense in the Series view
        var contentVisible = visible.filter(function (c) { return groupBy === 'series' || !isSeriesCard(c); });
        var realCount = visible.filter(function (c) { return !isSeriesCard(c); }).length;

        if (groupBy === 'series') {
          groupOrder.forEach(function (gid) {
            var cs = contentVisible.filter(function (c) { return c.getAttribute('data-group') === gid; });
            if (!cs.length) return;
            var epCount = cs.filter(function (c) { return !isSeriesCard(c); }).length;
            results.appendChild(makeSection(seriesHeader(gid, epCount), cs));
          });
        } else { // category
          categoryList.forEach(function (cat) {
            var cs = contentVisible.filter(function (c) {
              return (c.getAttribute('data-categories') || '').split(',').indexOf(cat.id) !== -1;
            });
            if (cs.length) results.appendChild(makeSection(simpleHeader(cat.label, cat.blurb, cs.length), cs));
          });
        }

        Array.prototype.forEach.call(results.querySelectorAll('.carousel'), wireCarousel);
        applyLikeState();

        var filtering = !!(query || format !== 'all' || category || series || starredOnly);
        if (countEl) {
          countEl.textContent = filtering
            ? (realCount + ' of ' + totalCount + ' interviews')
            : (totalCount + ' interviews');
        }
        if (noResults) noResults.hidden = realCount !== 0;
        if (clearBtn) clearBtn.hidden = !query;
        if (toolbarReset) toolbarReset.hidden = !filtering;
        if (starredBtn) starredBtn.setAttribute('aria-pressed', starredOnly ? 'true' : 'false');
        if (filtersToggle) filtersToggle.classList.toggle('has-active', format !== 'all' || !!category || !!series || starredOnly);
        syncUrl();
      }

      // ---- Wire controls ----
      searchInput.addEventListener('input', function () {
        query = searchInput.value.trim().toLowerCase();
        render();
      });
      if (clearBtn) clearBtn.addEventListener('click', function () {
        searchInput.value = ''; query = ''; searchInput.focus(); render();
      });
      formatSel.addEventListener('change', function () { format = formatSel.value; render(); });
      catSel.addEventListener('change', function () { category = catSel.value; render(); });
      seriesSel.addEventListener('change', function () { series = seriesSel.value; render(); });
      groupbySel.addEventListener('change', function () { groupBy = groupbySel.value; render(); });
      if (starredBtn) starredBtn.addEventListener('click', function () { starredOnly = !starredOnly; render(); });
      if (filtersToggle && filtersWrap) filtersToggle.addEventListener('click', function () {
        var open = filtersWrap.classList.toggle('open');
        filtersToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      Array.prototype.forEach.call(document.querySelectorAll('[data-reset]'), function (btn) {
        btn.addEventListener('click', function () {
          query = ''; format = 'all'; category = ''; series = ''; starredOnly = false;
          searchInput.value = '';
          formatSel.value = 'all'; catSel.value = ''; seriesSel.value = '';
          render();
        });
      });

      var rt;
      window.addEventListener('resize', function () {
        clearTimeout(rt);
        rt = setTimeout(function () {
          Array.prototype.forEach.call(results.querySelectorAll('.carousel'), updateArrows);
        }, 150);
      });

      // ---- Stars (shared /api/likes store; local state in localStorage) ----
      var LIKE_KEY = 'ttk_liked_interviews';
      function loadLiked() {
        try { var v = JSON.parse(localStorage.getItem(LIKE_KEY) || '[]'); return Array.isArray(v) ? v : []; }
        catch (e) { return []; }
      }
      function saveLiked(a) { try { localStorage.setItem(LIKE_KEY, JSON.stringify(a)); } catch (e) {} }
      var liked = loadLiked();
      var serverCounts = {};
      var localDelta = {};
      function likeCount(id) {
        var base = typeof serverCounts[id] === 'number' ? serverCounts[id] : 0;
        var n = base + (localDelta[id] || 0);
        return n < 0 ? 0 : n;
      }
      function applyLikeState() {
        Array.prototype.forEach.call(results.querySelectorAll('.iv-like'), function (btn) {
          var id = btn.getAttribute('data-like-id');
          var on = liked.indexOf(id) !== -1;
          btn.classList.toggle('is-liked', on);
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          var c = btn.querySelector('[data-like-count]');
          if (c) { var n = likeCount(id); c.textContent = n > 0 ? String(n) : ''; }
        });
      }
      // Cards are re-cloned on every render, so handle clicks via delegation.
      results.addEventListener('click', function (e) {
        var t = e.target;
        var btn = t && t.closest ? t.closest('.iv-like') : null;
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('data-like-id');
        var isLiked = liked.indexOf(id) !== -1;
        var delta = isLiked ? -1 : 1;
        liked = isLiked ? liked.filter(function (x) { return x !== id; }) : liked.concat([id]);
        saveLiked(liked);
        localDelta[id] = (localDelta[id] || 0) + delta;
        applyLikeState();
        if (starredOnly) {
          // The starred filter is active, so an unstarred card should drop out.
          render();
        } else if (!isLiked) {
          btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop');
        }
        fetch('/api/likes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toolId: id, delta: delta })
        }).catch(function () {});
      });
      fetch('/api/likes')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) { if (!data || !data.counts) return; serverCounts = data.counts; applyLikeState(); })
        .catch(function () {});

      // ---- Surprise me ----
      (function () {
        var overlay = document.querySelector('[data-suggest-modal]');
        var openBtn = document.querySelector('[data-suggest-open]');
        if (!overlay || !openBtn) return;
        var modal = overlay.querySelector('.sg-modal');
        var goBtn = overlay.querySelector('[data-suggest-go]');
        var resultEl = overlay.querySelector('[data-suggest-result]');
        var emptyEl = overlay.querySelector('[data-suggest-empty]');
        var SEEN_KEY = 'ttk_suggested_seen';
        var lastFocused = null;

        function loadSeen() {
          try { var v = JSON.parse(localStorage.getItem(SEEN_KEY) || '[]'); return Array.isArray(v) ? v : []; }
          catch (e) { return []; }
        }
        function saveSeen(a) { try { localStorage.setItem(SEEN_KEY, JSON.stringify(a)); } catch (e) {} }
        function checkedValues(sel) {
          return Array.prototype.slice.call(overlay.querySelectorAll(sel))
            .filter(function (cb) { return cb.checked; })
            .map(function (cb) { return cb.value; });
        }
        function esc(s) {
          return String(s).replace(/[&<>"]/g, function (ch) {
            return ch === '&' ? '&amp;' : ch === '<' ? '&lt;' : ch === '>' ? '&gt;' : '&quot;';
          });
        }

        function renderChoice(iv) {
          var langLabel = iv.language === 'english' ? 'English' : 'Spanish';
          var cta = iv.cta;
          var thumb = iv.thumb
            ? '<div class="sg-card-thumb"><img src="' + esc(iv.thumb) + '" alt="" loading="lazy" decoding="async" /></div>'
            : '';
          resultEl.innerHTML =
            '<a class="sg-card" href="' + esc(iv.url) + '" target="_blank" rel="noopener noreferrer">' +
              thumb +
              '<div class="sg-card-body">' +
                '<span class="sg-card-group">' + esc(iv.group) + ' · ' + langLabel + '</span>' +
                '<h3>' + esc(iv.title) + '</h3>' +
                '<span class="sg-card-cta">' + cta + ' ↗</span>' +
              '</div>' +
            '</a>' +
            '<button type="button" class="sg-again" data-suggest-again>Suggest another</button>';
          resultEl.hidden = false;
          var again = resultEl.querySelector('[data-suggest-again]');
          if (again) again.addEventListener('click', pick);
        }

        function pick() {
          var langs = checkedValues('[data-sg-lang]');
          var cats = checkedValues('[data-sg-cat]');
          var pool = suggestPool.filter(function (iv) {
            if (langs.length && langs.indexOf(iv.language) === -1) return false;
            if (cats.length && !iv.categories.some(function (c) { return cats.indexOf(c) !== -1; })) return false;
            return true;
          });
          if (!pool.length) { resultEl.hidden = true; emptyEl.hidden = false; return; }
          emptyEl.hidden = true;
          var seen = loadSeen();
          var unseen = pool.filter(function (iv) { return seen.indexOf(iv.id) === -1; });
          if (!unseen.length) {
            var inPool = {};
            pool.forEach(function (iv) { inPool[iv.id] = 1; });
            seen = seen.filter(function (id) { return !inPool[id]; });
            unseen = pool;
          }
          var choice = unseen[Math.floor(Math.random() * unseen.length)];
          seen.push(choice.id);
          saveSeen(seen);
          renderChoice(choice);
        }

        function open() {
          lastFocused = document.activeElement;
          overlay.classList.add('sg-open');
          document.body.style.overflow = 'hidden';
          if (modal) modal.focus();
        }
        function close() {
          overlay.classList.remove('sg-open');
          document.body.style.overflow = '';
          if (lastFocused && lastFocused.focus) lastFocused.focus();
        }

        openBtn.addEventListener('click', open);
        Array.prototype.forEach.call(overlay.querySelectorAll('[data-suggest-close]'), function (b) {
          b.addEventListener('click', close);
        });
        overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
