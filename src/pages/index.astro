---
import BaseLayout from '../layouts/BaseLayout.astro';
import SupportModal from '../components/SupportModal.astro';
import { products } from '../data/products';
import { recentlyAdded, formatDate } from '../data/recent';

const recentItems = recentlyAdded(4);
---

<BaseLayout title="Home" description="The Tango Toolkit - Tools and resources for tango DJs. Software, starter kits, and guides to elevate your tango DJing.">
  <section class="hero">
    <div class="container">
      <h1>Welcome to The Tango Toolkit</h1>
      <p class="hero-subtitle">The tools you need to elevate your tango</p>
      <p class="hero-intro">The Tango Toolkit is an expanding collection of quality resources for tango. It currently has tools and resources for tango DJs of all levels. Resources for tango dancers and organizers will be coming!</p>
    </div>
  </section>
  <section class="cta-section">
    <div class="container">
      <div class="cta-grid">
        <a href="/dj/starter-kit/" class="cta-card">
          <div class="cta-icon">🚀</div>
          <h2>DJ Starter Kit</h2>
          <p>Everything you need to start tango DJing — software, music, and step-by-step guides.</p>
          <span class="cta-link">Get Started &rarr;</span>
        </a>
        <a href="/dj/tools/" class="cta-card">
          <div class="cta-icon">💻</div>
          <h2>DJ Tools</h2>
          <p>Players, displays, tanda builders, and plugins — tools for tango DJs from us and the community.</p>
          <span class="cta-link">Browse Tools &rarr;</span>
        </a>
        <a href="/discographies/" class="cta-card">
          <div class="cta-icon">📚</div>
          <h2>Discographies</h2>
          <p>Discographies, articles, and guides to deepen your knowledge of tango music.</p>
          <span class="cta-link">Explore Discographies &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="recent-section">
    <div class="container">
      <div class="recent-header">
        <h2 class="section-heading">Recently Added</h2>
        <a href="/dj/tools/" class="recent-all-link">All DJ tools &rarr;</a>
      </div>
      <div class="recent-grid">
        {recentItems.map((item) => (
          <a
            href={item.href}
            class="recent-card"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            <div class="recent-meta">
              <span class="recent-tag">{item.tag}</span>
              <time datetime={item.date}>{formatDate(item.date)}</time>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="engage-section">
    <div class="container">
      <div class="subscribe-bar">
        <div class="subscribe-text">
          <h2>Stay in the Loop</h2>
          <p>Get updates on new tools, features, and tango resources.</p>
        </div>
        <form class="subscribe-form" id="subscribeForm">
          <input type="email" id="subscribeEmail" placeholder="Your email address" required />
          <button type="submit" class="btn btn-primary" id="subscribeBtn">Subscribe</button>
        </form>
        <p class="subscribe-msg" id="subscribeMsg"></p>
      </div>
      <SupportModal />
    </div>
  </section>

  <script is:inline>
  (function() {
    // Subscribe form
    var form = document.getElementById('subscribeForm');
    var emailInput = document.getElementById('subscribeEmail');
    var btn = document.getElementById('subscribeBtn');
    var msg = document.getElementById('subscribeMsg');

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = emailInput.value.trim();
      if (!email) return;

      btn.disabled = true;
      btn.textContent = 'Subscribing...';
      msg.textContent = '';
      msg.className = 'subscribe-msg';

      fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email })
      })
      .then(function(res) {
        if (!res.ok) throw new Error(res.statusText);
        return res.json();
      })
      .then(function() {
        msg.textContent = 'You\'re subscribed! Thanks for joining.';
        msg.className = 'subscribe-msg subscribe-success';
        emailInput.value = '';
      })
      .catch(function() {
        msg.textContent = 'Something went wrong. Please try again.';
        msg.className = 'subscribe-msg subscribe-error';
      })
      .finally(function() {
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      });
    });
  })();
  </script>

  <section class="tools-section">
    <div class="container">
      <hr class="section-divider" />
      <h2 class="section-heading">Tango Toolkit Software</h2>
      <div class="tools-list">
        {products.map((product) => (
          <article class="tool-row">
            <div class="tool-info">
              <h3>{product.name}</h3>
              <p class="tool-tagline">{product.tagline}</p>
              <p class="tool-desc">{product.description}</p>
            </div>
            <div class="tool-side">
              {product.image && (
                <div class="tool-image">
                  <picture>
                    <source srcset={product.image.replace(/\.png$/i, '.webp')} type="image/webp" />
                    <img src={product.image} alt={product.name} width="240" height="240" loading="lazy" decoding="async" />
                  </picture>
                </div>
              )}
              <div class="tool-actions">
                <a href={`/dj/software/#${product.id}`} class="btn btn-primary">
                  {product.price === 'Free' ? 'FREE! Get It Here' : 'Get It Here'} &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0;
    background:
      linear-gradient(135deg, rgba(255,247,237,0.88) 0%, rgba(255,255,255,0.82) 50%, rgba(255,247,237,0.88) 100%),
      image-set(url('/images/Logo.webp') type('image/webp'), url('/images/Logo.png') type('image/png')) center / 80% no-repeat;
    border-bottom: 1px solid var(--color-orange-100);
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0 0 1rem;
    color: var(--color-slate-900);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-slate-600);
    max-width: 40ch;
    margin: 0;
  }

  .hero-intro {
    font-size: 1.05rem;
    color: var(--color-slate-700);
    max-width: 65ch;
    margin: 1rem 0 0;
    line-height: 1.6;
  }

  /* CTA Cards */
  .cta-section {
    padding: 3rem 0;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .cta-grid {
      grid-template-columns: 1fr;
    }
  }

  .cta-card {
    display: block;
    background: linear-gradient(180deg, var(--color-orange-50) 0%, white 100%);
    border: 2px solid var(--color-orange-400);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .cta-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .cta-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .cta-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
  }

  .cta-card p {
    margin: 0 0 1.25rem;
    color: var(--color-slate-600);
    font-size: 0.95rem;
  }

  .cta-link {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 1rem;
  }

  /* Recently Added */
  .recent-section {
    padding: 0 0 3rem;
  }

  .recent-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .recent-header .section-heading {
    margin: 0;
  }

  .recent-all-link {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }

  .recent-card {
    display: block;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.25rem;
    color: inherit;
    text-decoration: none;
    transition: all 0.2s;
  }

  .recent-card:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .recent-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .recent-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-orange-700);
    background: var(--color-orange-100);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }

  .recent-meta time {
    font-size: 0.78rem;
    color: var(--color-slate-400);
    white-space: nowrap;
  }

  .recent-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .recent-card p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-slate-600);
    line-height: 1.5;
  }

  /* DJ Tools Section */
  .tools-section {
    padding: 0 0 4rem;
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--color-slate-200);
    margin: 0 0 2rem;
  }

  .section-heading {
    margin: 0 0 2rem;
  }

  .tools-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .tool-row {
    display: flex;
    gap: 2rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: all 0.2s;
  }

  .tool-row:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
  }

  .tool-info {
    flex: 2;
    min-width: 0;
  }

  .tool-info h3 {
    margin: 0 0 0.25rem;
    font-size: 1.35rem;
  }

  .tool-tagline {
    font-style: italic;
    color: var(--color-orange-600);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .tool-desc {
    margin: 0;
    color: var(--color-slate-600);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .tool-side {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }

  .tool-image {
    width: 100%;
    max-width: 240px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-slate-100);
  }

  .tool-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .tool-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 240px;
  }

  @media (max-width: 768px) {
    .tool-row {
      flex-direction: column;
    }

    .tool-side {
      align-items: flex-start;
    }

    .tool-image,
    .tool-actions {
      max-width: 100%;
    }
  }

  /* Engage Section (Subscribe + Support) */
  .engage-section {
    padding: 0 0 1.5rem;
  }

  .subscribe-bar {
    background: linear-gradient(135deg, var(--color-orange-50) 0%, white 100%);
    border: 1px solid var(--color-orange-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .subscribe-text {
    flex: 1;
    min-width: 200px;
  }

  .subscribe-text h2 {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
  }

  .subscribe-text p {
    margin: 0;
    color: var(--color-slate-600);
    font-size: 0.95rem;
  }

  .subscribe-form {
    display: flex;
    gap: 0.5rem;
    flex: 1;
    min-width: 280px;
    max-width: 420px;
  }

  .subscribe-form input {
    flex: 1;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-slate-300);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-family: 'Outfit', system-ui, sans-serif;
  }

  .subscribe-form input:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .subscribe-form button {
    white-space: nowrap;
  }

  .subscribe-msg {
    width: 100%;
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    min-height: 1.2em;
  }
  .subscribe-msg:empty {
    display: none;
  }

  .subscribe-success {
    color: var(--color-green-700);
  }

  .subscribe-error {
    color: var(--color-red-600);
  }

  @media (max-width: 600px) {
    .subscribe-bar {
      padding: 1.25rem;
      gap: 1rem;
    }

    .subscribe-form {
      flex-direction: column;
      max-width: 100%;
    }
  }

</style>
