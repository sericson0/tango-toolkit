---
import BaseLayout from '../layouts/BaseLayout.astro';
import SupportModal from '../components/SupportModal.astro';
import { products } from '../data/products';
import { recentlyAdded, formatDate } from '../data/recent';

const recentItems = recentlyAdded(4);

// Hisstory Lite shares a row with Hisstory Full on the home page
const homeProducts = products.filter((p) => p.id !== 'hisstory-lite');

// Inline icons (Feather, MIT) — consistent rendering across platforms, unlike emoji
const ICON_ATTRS = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const PLAY_SVG = `<svg ${ICON_ATTRS}><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>`;
const SLIDERS_SVG = `<svg ${ICON_ATTRS}><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>`;
const DISC_SVG = `<svg ${ICON_ATTRS}><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>`;
---

<BaseLayout title="Home" description="The Tango Toolkit - Tools and resources for tango DJs. Software, starter kits, and guides to elevate your tango DJing.">
  <section class="hero">
    <div class="container">
      <h1>Welcome to The Tango Toolkit</h1>
      <p class="hero-subtitle">The tools you need to elevate your tango</p>
      <p class="hero-intro">An expanding collection of quality tools and resources for tango DJs of all levels &mdash; with resources for dancers and organizers on the way.</p>
      <div class="hero-actions">
        <a href="/dj/starter-kit/" class="btn btn-primary btn-lg">Get the Starter Kit</a>
        <a href="/dj/tools/" class="btn btn-secondary btn-lg">Browse DJ Tools</a>
      </div>
    </div>
  </section>
  <section class="cta-section">
    <div class="container">
      <div class="cta-grid">
        <a href="/dj/starter-kit/" class="cta-card">
          <div class="cta-icon" set:html={PLAY_SVG}></div>
          <h2>DJ Starter Kit</h2>
          <p>Everything you need to start tango DJing — software, music, and step-by-step guides.</p>
          <span class="cta-link">Get Started &rarr;</span>
        </a>
        <a href="/dj/tools/" class="cta-card">
          <div class="cta-icon" set:html={SLIDERS_SVG}></div>
          <h2>DJ Tools</h2>
          <p>Players, displays, tanda builders, and plugins — tools for tango DJs from us and the community.</p>
          <span class="cta-link">Browse Tools &rarr;</span>
        </a>
        <a href="/discographies/" class="cta-card">
          <div class="cta-icon" set:html={DISC_SVG}></div>
          <h2>Discographies</h2>
          <p>Discographies, articles, and guides to deepen your knowledge of tango music.</p>
          <span class="cta-link">Explore Discographies &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="recent-section">
    <div class="container">
      <div class="recent-header">
        <h2 class="section-heading">Recently Added</h2>
        <a href="/dj/tools/" class="recent-all-link">All DJ tools &rarr;</a>
      </div>
      <div class="recent-grid">
        {recentItems.map((item) => (
          <a
            href={item.href}
            class="recent-card"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            <div class="recent-meta">
              <span class="recent-tag">{item.tag}</span>
              <time datetime={item.date}>{formatDate(item.date)}</time>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="engage-section" id="subscribe">
    <div class="container">
      <div class="subscribe-bar">
        <div class="subscribe-text">
          <h2>Stay in the Loop</h2>
          <p>Get updates on new tools, features, and tango resources.</p>
        </div>
        <form class="subscribe-form" id="subscribeForm">
          <input type="email" id="subscribeEmail" aria-label="Email address" placeholder="Your email address" required />
          <button type="submit" class="btn btn-primary" id="subscribeBtn">Subscribe</button>
        </form>
        <p class="subscribe-msg" id="subscribeMsg" role="status"></p>
        <p class="support-note">Enjoying the tools? <button type="button" class="support-link" data-support-open>Help support the Tango Toolkit</button></p>
      </div>
      <SupportModal showButton={false} />
    </div>
  </section>

  <script is:inline>
  (function() {
    // Subscribe form
    var form = document.getElementById('subscribeForm');
    var emailInput = document.getElementById('subscribeEmail');
    var btn = document.getElementById('subscribeBtn');
    var msg = document.getElementById('subscribeMsg');

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = emailInput.value.trim();
      if (!email) return;

      btn.disabled = true;
      btn.textContent = 'Subscribing...';
      msg.textContent = '';
      msg.className = 'subscribe-msg';

      fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email })
      })
      .then(function(res) {
        if (!res.ok) throw new Error(res.statusText);
        return res.json();
      })
      .then(function() {
        msg.textContent = 'You\'re subscribed! Thanks for joining.';
        msg.className = 'subscribe-msg subscribe-success';
        emailInput.value = '';
      })
      .catch(function() {
        msg.textContent = 'Something went wrong. Please try again.';
        msg.className = 'subscribe-msg subscribe-error';
      })
      .finally(function() {
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      });
    });
  })();
  </script>

  <section class="tools-section">
    <div class="container">
      <hr class="section-divider" />
      <h2 class="section-heading">Tango Toolkit Software</h2>
      <div class="tools-list">
        {homeProducts.map((product) => (
          <article class="tool-row">
            <div class="tool-info">
              <h3>{product.name}</h3>
              <p class="tool-tagline">{product.tagline}</p>
              <p class="tool-desc">{product.description}</p>
            </div>
            <div class="tool-side">
              {product.image && (
                <div class="tool-image">
                  <picture>
                    <source srcset={product.image.replace(/\.png$/i, '.webp')} type="image/webp" />
                    <img src={product.image} alt={product.name} width="240" height="240" loading="lazy" decoding="async" />
                  </picture>
                </div>
              )}
              <div class="tool-actions">
                <a href={`/dj/software/#${product.id}`} class="btn btn-primary">
                  {product.price === 'Free' ? 'FREE! Get It Here' : 'Get It Here'} &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0;
    background:
      linear-gradient(90deg, rgba(255,247,237,0.97) 0%, rgba(255,255,255,0.9) 55%, rgba(255,247,237,0.45) 100%),
      image-set(url('/images/Logo.webp') type('image/webp'), url('/images/Logo.png') type('image/png')) right 4rem center / clamp(18rem, 32vw, 26rem) no-repeat;
    border-bottom: 1px solid var(--color-orange-100);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3.5rem 0;
      background:
        linear-gradient(135deg, rgba(255,247,237,0.95) 0%, rgba(255,255,255,0.92) 100%),
        image-set(url('/images/Logo.webp') type('image/webp'), url('/images/Logo.png') type('image/png')) center / 80% no-repeat;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero-actions .btn-secondary {
    background: white;
    border: 1px solid var(--color-slate-300);
  }

  .hero-actions .btn-secondary:hover {
    background: white;
    border-color: var(--color-orange-400);
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0 0 1rem;
    color: var(--color-slate-900);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-slate-600);
    max-width: 40ch;
    margin: 0;
  }

  .hero-intro {
    font-size: 1.05rem;
    color: var(--color-slate-700);
    max-width: 65ch;
    margin: 1rem 0 0;
    line-height: 1.6;
  }

  /* CTA Cards */
  .cta-section {
    padding: 3rem 0;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .cta-grid {
      grid-template-columns: 1fr;
    }
  }

  .cta-card {
    display: block;
    background: linear-gradient(180deg, var(--color-orange-50) 0%, white 100%);
    border: 2px solid var(--color-orange-400);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .cta-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-orange-500);
    margin-bottom: 0.75rem;
  }

  .cta-icon :global(svg) {
    width: 2.75rem;
    height: 2.75rem;
  }

  .cta-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
  }

  .cta-card p {
    margin: 0 0 1.25rem;
    color: var(--color-slate-600);
    font-size: 0.95rem;
  }

  .cta-link {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 1rem;
  }

  /* Recently Added */
  .recent-section {
    padding: 0 0 3rem;
  }

  .recent-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .recent-header .section-heading {
    margin: 0;
  }

  .recent-all-link {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }

  .recent-card {
    display: block;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.25rem;
    color: inherit;
    text-decoration: none;
    transition: all 0.2s;
  }

  .recent-card:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .recent-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .recent-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-orange-700);
    background: var(--color-orange-100);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }

  .recent-meta time {
    font-size: 0.78rem;
    color: var(--color-slate-400);
    white-space: nowrap;
  }

  .recent-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .recent-card p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-slate-600);
    line-height: 1.5;
  }

  /* DJ Tools Section */
  .tools-section {
    padding: 0 0 4rem;
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--color-slate-200);
    margin: 0 0 2rem;
  }

  .section-heading {
    margin: 0 0 2rem;
  }

  .tools-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .tool-row {
    display: flex;
    gap: 2rem;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: all 0.2s;
  }

  .tool-row:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
  }

  .tool-info {
    flex: 2;
    min-width: 0;
  }

  .tool-info h3 {
    margin: 0 0 0.25rem;
    font-size: 1.35rem;
  }

  .tool-tagline {
    font-style: italic;
    color: var(--color-orange-600);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .tool-desc {
    margin: 0;
    color: var(--color-slate-600);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .tool-side {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }

  .tool-image {
    width: 100%;
    max-width: 240px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-slate-100);
  }

  .tool-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .tool-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 240px;
  }

  @media (max-width: 768px) {
    .tool-row {
      flex-direction: column;
    }

    .tool-side {
      align-items: flex-start;
    }

    .tool-image,
    .tool-actions {
      max-width: 100%;
    }
  }

  /* Engage Section (Subscribe + Support) */
  .engage-section {
    padding: 0 0 1.5rem;
  }

  .subscribe-bar {
    background: linear-gradient(135deg, var(--color-orange-50) 0%, white 100%);
    border: 1px solid var(--color-orange-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .subscribe-text {
    flex: 1;
    min-width: 200px;
  }

  .subscribe-text h2 {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
  }

  .subscribe-text p {
    margin: 0;
    color: var(--color-slate-600);
    font-size: 0.95rem;
  }

  .subscribe-form {
    display: flex;
    gap: 0.5rem;
    flex: 1;
    min-width: 280px;
    max-width: 420px;
  }

  .subscribe-form input {
    flex: 1;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-slate-300);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-family: 'Outfit', system-ui, sans-serif;
  }

  .subscribe-form input:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .subscribe-form button {
    white-space: nowrap;
  }

  .subscribe-msg {
    width: 100%;
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    min-height: 1.2em;
  }
  .subscribe-msg:empty {
    display: none;
  }

  .subscribe-success {
    color: var(--color-green-700);
  }

  .subscribe-error {
    color: var(--color-red-600);
  }

  .support-note {
    width: 100%;
    margin: 0.75rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-orange-100);
    font-size: 0.9rem;
    color: var(--color-slate-600);
  }

  .support-link {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .support-link:hover {
    color: var(--color-primary-hover);
  }

  @media (max-width: 600px) {
    .subscribe-bar {
      padding: 1.25rem;
      gap: 1rem;
    }

    .subscribe-form {
      flex-direction: column;
      max-width: 100%;
    }
  }

</style>
