---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import { toolCategories, getToolsByCategory, isNew } from '../../../data/tools';

// Placeholder icon for tools without artwork (Feather "music", MIT)
const MUSIC_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';
---

<BaseLayout title="DJ Tools" description="A directory of tools for tango DJs — players, displays and projections, tanda builders, and audio plugins. From The Tango Toolkit and the wider tango community.">
  <PageHero
    title="DJ Tools"
    lead="Tools for tango DJs — from The Tango Toolkit and the wider tango community. Know a tool that belongs here? Tell us at tangotoolkit@gmail.com."
  />

  <nav class="category-nav" aria-label="Tool categories">
    <div class="container category-chips">
      {toolCategories.map((cat) => (
        <a href={`#${cat.id}`} class="category-chip">{cat.title}</a>
      ))}
    </div>
  </nav>

  {toolCategories.map((cat, i) => {
    const catTools = getToolsByCategory(cat.id);
    return (
      <section id={cat.id} class:list={['category-section', { 'alt-bg': i % 2 === 1 }]}>
        <div class="container">
          <h2>{cat.title}</h2>
          <p class="category-blurb">{cat.blurb}</p>
          {catTools.length === 0 ? (
            <p class="category-empty">Nothing here yet — suggestions welcome at <a href="mailto:tangotoolkit@gmail.com">tangotoolkit@gmail.com</a>.</p>
          ) : (
            <div class="tool-grid">
              {catTools.map((tool) => (
                <article class="tool-card">
                  <div class="tool-card-top">
                    {tool.image ? (
                      <picture>
                        <source srcset={tool.image.replace(/\.png$/i, '.webp')} type="image/webp" />
                        <img src={tool.image} alt="" class="tool-card-img" width="56" height="56" loading="lazy" decoding="async" />
                      </picture>
                    ) : (
                      <div class="tool-card-img tool-card-img--placeholder" aria-hidden="true" set:html={MUSIC_SVG}></div>
                    )}
                    <div class="tool-card-title">
                      <h3>
                        {tool.name}
                        {isNew(tool) && <span class="new-badge">New</span>}
                      </h3>
                      <span class="tool-card-author">by {tool.author}</span>
                    </div>
                  </div>
                  <p class="tool-card-tagline">{tool.tagline}</p>
                  <p class="tool-card-desc" set:html={tool.description} />
                  <div class="tool-card-meta">
                    <span class="price-chip">{tool.price}</span>
                    {tool.platforms && <span class="platform-note">{tool.platforms.join(' · ')}</span>}
                    <span class="tool-card-actions">
                      {tool.downloadUrl && (
                        <a
                          href={tool.downloadUrl}
                          class="tool-card-dl"
                          target={tool.external ? '_blank' : undefined}
                          rel={tool.external ? 'noopener noreferrer' : undefined}
                        >Download</a>
                      )}
                      <a
                        href={tool.url}
                        class="tool-card-cta"
                        target={tool.external ? '_blank' : undefined}
                        rel={tool.external ? 'noopener noreferrer' : undefined}
                      >{tool.external ? 'Visit Site ↗' : 'Details →'}</a>
                    </span>
                  </div>
                  {tool.downloads && tool.downloads.length > 0 && (
                    <div class="tool-card-downloads">
                      <span class="tool-card-dl-label">Download</span>
                      {tool.downloads.map((dl) => (
                        <a
                          href={dl.url}
                          class="tool-card-dl-platform"
                          target={tool.external ? '_blank' : undefined}
                          rel={tool.external ? 'noopener noreferrer' : undefined}
                        >{dl.platform}</a>
                      ))}
                    </div>
                  )}
                  {tool.downloads && tool.downloads.filter((dl) => dl.note).map((dl) => (
                    <p class="tool-card-dl-note">{dl.note}</p>
                  ))}
                  <div class="tool-card-social">
                    <button
                      type="button"
                      class="tool-like"
                      data-tool-id={tool.id}
                      aria-pressed="false"
                      aria-label={`Like ${tool.name}`}
                      title={`Like ${tool.name}`}
                    >
                      <svg class="tool-like-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      <span class="tool-like-count" data-like-count aria-hidden="true"></span>
                    </button>
                    {/* Feedback button temporarily disabled. Re-enable to route
                        per-tool feedback to authors (see /api/feedback + tools.ts feedbackEmail).
                    <button
                      type="button"
                      class="tool-feedback"
                      data-feedback-open
                      data-tool-id={tool.id}
                      data-tool-name={tool.name}
                      data-tool-external={tool.external ? '1' : ''}
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                      Feedback
                    </button>
                    */}
                    <span class="tool-version" data-tool-version data-tool-id={tool.id} hidden></span>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    );
  })}

  <section class="suggest-section">
    <div class="container">
      <div class="callout callout-tip">
        <strong>Made something for tango DJs?</strong>
        <p>This directory is growing. If you built (or love) a tool that should be listed here, email <a href="mailto:tangotoolkit@gmail.com">tangotoolkit@gmail.com</a> and we&rsquo;ll check it out.</p>
      </div>
    </div>
  </section>

  <div class="tf-overlay" data-feedback-modal>
    <div class="tf-modal" role="dialog" aria-modal="true" aria-labelledby="tf-title">
      <button class="tf-close" type="button" aria-label="Close" data-feedback-close>&times;</button>
      <h2 id="tf-title">Send feedback</h2>
      <p class="tf-sub">Your message about <strong data-feedback-tool-name>this tool</strong> goes to <span data-feedback-dest>the developer</span>.</p>
      <form data-feedback-form novalidate>
        <label class="tf-label" for="tf-message">Your feedback</label>
        <textarea id="tf-message" class="tf-textarea" data-feedback-message rows="5" maxlength="4000" required placeholder="What do you love, what could be better, or what's broken?"></textarea>
        <label class="tf-label" for="tf-email">Your email <span class="tf-optional">(optional — so they can reply)</span></label>
        <input id="tf-email" class="tf-input" data-feedback-email type="email" autocomplete="email" placeholder="you@example.com" />
        <div class="tf-actions">
          <button type="button" class="tf-btn tf-btn-secondary" data-feedback-close>Cancel</button>
          <button type="submit" class="tf-btn tf-btn-primary">Send feedback</button>
        </div>
        <p class="tf-status" data-feedback-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <script is:inline>
    (function () {
      // ===== Likes ===============================================
      var LIKE_KEY = 'ttk_liked_tools';
      function loadLiked() {
        try { var v = JSON.parse(localStorage.getItem(LIKE_KEY) || '[]'); return Array.isArray(v) ? v : []; }
        catch (e) { return []; }
      }
      function saveLiked(a) { try { localStorage.setItem(LIKE_KEY, JSON.stringify(a)); } catch (e) {} }

      var liked = loadLiked();
      var likeButtons = Array.prototype.slice.call(document.querySelectorAll('.tool-like'));
      var serverCounts = {};   // toolId -> count loaded from the server
      var localDelta = {};     // toolId -> this session's net change vs. that baseline

      function countEl(btn) { return btn.querySelector('[data-like-count]'); }
      function setLiked(btn, on) {
        btn.classList.toggle('is-liked', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
      function render(btn) {
        var id = btn.getAttribute('data-tool-id');
        var base = typeof serverCounts[id] === 'number' ? serverCounts[id] : 0;
        var n = base + (localDelta[id] || 0);
        if (n < 0) n = 0;
        countEl(btn).textContent = n > 0 ? String(n) : '';
      }

      likeButtons.forEach(function (btn) {
        var id = btn.getAttribute('data-tool-id');
        if (liked.indexOf(id) !== -1) setLiked(btn, true);
        render(btn);
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var isLiked = liked.indexOf(id) !== -1;
          var delta = isLiked ? -1 : 1;
          liked = isLiked ? liked.filter(function (x) { return x !== id; }) : liked.concat([id]);
          saveLiked(liked);
          localDelta[id] = (localDelta[id] || 0) + delta;
          setLiked(btn, !isLiked);
          render(btn);
          if (!isLiked) { btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop'); }
          fetch('/api/likes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ toolId: id, delta: delta })
          }).catch(function () {});
        });
      });

      fetch('/api/likes')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || !data.counts) return;
          serverCounts = data.counts;
          likeButtons.forEach(render);
        })
        .catch(function () {});

      // ===== Tool versions (live from GitHub releases) ===========
      fetch('/api/tool-releases')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || !data.releases) return;
          document.querySelectorAll('[data-tool-version]').forEach(function (el) {
            var rel = data.releases[el.getAttribute('data-tool-id')];
            if (!rel || !rel.version) return;
            var text = /^v/i.test(rel.version) ? rel.version : 'v' + rel.version;
            if (rel.updated) {
              var d = new Date(rel.updated);
              if (!isNaN(d.getTime())) {
                text += ' · updated ' + d.toLocaleDateString(undefined, { month: 'short', year: 'numeric' });
              }
            }
            el.textContent = text;
            el.hidden = false;
          });
        })
        .catch(function () {});

      // ===== Feedback modal ======================================
      var modal = document.querySelector('[data-feedback-modal]');
      if (!modal) return;
      var form = modal.querySelector('[data-feedback-form]');
      var nameEl = modal.querySelector('[data-feedback-tool-name]');
      var destEl = modal.querySelector('[data-feedback-dest]');
      var statusEl = modal.querySelector('[data-feedback-status]');
      var msgEl = modal.querySelector('[data-feedback-message]');
      var emailEl = modal.querySelector('[data-feedback-email]');
      var submitBtn = form.querySelector('[type="submit"]');
      var currentTool = null;
      var lastFocused = null;

      function setStatus(text, kind) {
        statusEl.textContent = text || '';
        statusEl.className = 'tf-status' + (kind ? ' tf-status--' + kind : '');
      }
      function openModal(id, name, external) {
        currentTool = id;
        lastFocused = document.activeElement;
        nameEl.textContent = name;
        destEl.textContent = external ? ('the developer of ' + name) : 'the Tango Toolkit team';
        setStatus('');
        form.reset();
        submitBtn.disabled = false;
        modal.classList.add('tf-open');
        document.body.style.overflow = 'hidden';
        setTimeout(function () { msgEl.focus(); }, 30);
      }
      function closeModal() {
        modal.classList.remove('tf-open');
        document.body.style.overflow = '';
        currentTool = null;
        if (lastFocused && lastFocused.focus) lastFocused.focus();
      }

      document.querySelectorAll('[data-feedback-open]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          openModal(
            btn.getAttribute('data-tool-id'),
            btn.getAttribute('data-tool-name'),
            btn.getAttribute('data-tool-external') === '1'
          );
        });
      });
      modal.querySelectorAll('[data-feedback-close]').forEach(function (b) {
        b.addEventListener('click', closeModal);
      });
      modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal.classList.contains('tf-open')) closeModal();
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!currentTool) return;
        var message = msgEl.value.trim();
        if (!message) { setStatus('Please enter a message.', 'err'); msgEl.focus(); return; }
        submitBtn.disabled = true;
        setStatus('Sending…');
        fetch('/api/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toolId: currentTool, message: message, email: emailEl.value.trim() })
        })
          .then(function (r) {
            if (r.ok) {
              setStatus('Thanks! Your feedback was sent.', 'ok');
              form.reset();
              setTimeout(closeModal, 1600);
            } else {
              throw new Error('bad status');
            }
          })
          .catch(function () {
            setStatus('Sorry, something went wrong. Please try again or email tangotoolkit@gmail.com.', 'err');
          })
          .finally(function () { submitBtn.disabled = false; });
      });
    })();
  </script>
</BaseLayout>

<style>
  /* Category quick-nav */
  .category-nav {
    position: sticky;
    top: var(--header-height);
    z-index: 50;
    background: white;
    border-bottom: 1px solid var(--color-slate-200);
    padding: 0.6rem 0;
  }

  .category-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .category-chip {
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--color-slate-300);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-slate-600);
    background: white;
    transition: all 0.15s;
  }

  .category-chip:hover {
    border-color: var(--color-orange-400);
    color: var(--color-orange-700);
    background: var(--color-orange-50);
  }

  /* Category sections */
  .category-section {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-slate-200);
    scroll-margin-top: calc(var(--header-height) + 3.5rem);
  }

  .category-section.alt-bg {
    background: var(--color-slate-50);
  }

  .category-section h2 {
    margin: 0 0 0.35rem;
    font-size: 1.75rem;
  }

  .category-blurb {
    margin: 0 0 1.5rem;
    color: var(--color-slate-600);
    max-width: 65ch;
  }

  .category-empty {
    color: var(--color-slate-500);
    font-size: 0.95rem;
  }

  /* Tool cards */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    color: inherit;
    text-decoration: none;
    transition: all 0.2s;
  }

  .alt-bg .tool-card {
    border-color: var(--color-slate-300);
  }

  .tool-card:hover {
    border-color: var(--color-orange-400);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .tool-card-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .tool-card-img {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    object-fit: contain;
    background: var(--color-slate-100);
    flex-shrink: 0;
  }

  .tool-card-img--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-slate-400);
  }

  .tool-card-img--placeholder :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .tool-card-title h3 {
    margin: 0;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tool-card-author {
    font-size: 0.8rem;
    color: var(--color-slate-500);
  }

  .new-badge {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-slate-600);
    color: white;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
  }

  .tool-card-tagline {
    margin: 0 0 0.5rem;
    font-style: italic;
    color: var(--color-slate-500);
    font-size: 0.9rem;
  }

  .tool-card-desc {
    margin: 0 0 1rem;
    color: var(--color-slate-600);
    font-size: 0.92rem;
    line-height: 1.55;
    flex: 1;
  }

  .tool-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .price-chip {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--color-label-bg);
    color: var(--color-label-text);
  }

  .platform-note {
    font-size: 0.78rem;
    color: var(--color-slate-500);
  }

  .tool-card-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Primary link stretches over the whole card */
  .tool-card-cta {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .tool-card-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  /* Download button sits above the stretched link */
  .tool-card-dl {
    position: relative;
    z-index: 1;
    font-size: 0.82rem;
    font-weight: 600;
    color: white;
    background: var(--color-primary);
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-md);
    white-space: nowrap;
    transition: background 0.2s;
  }

  .tool-card-dl:hover {
    background: var(--color-primary-hover);
    color: white;
  }

  /* Per-platform downloads (sits above the stretched card link) */
  .tool-card-downloads {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.85rem;
  }

  .tool-card-dl-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-slate-500);
  }

  .tool-card-dl-platform {
    position: relative;
    z-index: 1;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
    background: white;
    border: 1px solid var(--color-slate-300);
    padding: 0.28rem 0.75rem;
    border-radius: var(--radius-md);
    white-space: nowrap;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }

  .tool-card-dl-platform:hover {
    border-color: var(--color-orange-400);
    background: var(--color-orange-50);
    color: var(--color-orange-700);
  }

  .tool-card-dl-note {
    position: relative;
    z-index: 1;
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-slate-500);
  }

  /* Star (like) + feedback row — sits above the stretched card link */
  .tool-card-social {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-slate-100);
  }

  .tool-like,
  .tool-feedback {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 1px solid var(--color-slate-200);
    border-radius: 999px;
    padding: 0.32rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-slate-500);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .tool-like { padding: 0.32rem 0.62rem; }
  .tool-feedback { margin-left: auto; }

  .tool-like:hover,
  .tool-feedback:hover {
    border-color: var(--color-orange-400);
    color: var(--color-orange-600);
    background: var(--color-orange-50);
  }

  .tool-like:focus-visible,
  .tool-feedback:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .tool-like-star {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .tool-like.is-liked {
    color: var(--color-orange-600);
    border-color: var(--color-orange-200);
    background: var(--color-orange-50);
  }

  .tool-like.is-liked .tool-like-star {
    fill: var(--color-orange-500);
    stroke: var(--color-orange-500);
  }

  .tool-like-count {
    font-variant-numeric: tabular-nums;
    min-width: 0.4rem;
  }
  .tool-like-count:empty { display: none; }

  .tool-feedback svg { width: 1rem; height: 1rem; }

  /* Live version + last-updated, filled in by JS from /api/tool-releases */
  .tool-version {
    margin-left: auto;
    text-align: right;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--color-slate-400);
    font-variant-numeric: tabular-nums;
  }
  .tool-version[hidden] { display: none; }

  @keyframes ttk-pop {
    0% { transform: scale(1); }
    40% { transform: scale(1.35); }
    100% { transform: scale(1); }
  }
  .tool-like.pop .tool-like-star { animation: ttk-pop 0.3s ease; }

  @media (prefers-reduced-motion: reduce) {
    .tool-like.pop .tool-like-star { animation: none; }
  }

  /* Feedback modal */
  .tf-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .tf-overlay.tf-open { display: flex; }

  .tf-modal {
    background: white;
    border-radius: var(--radius-lg);
    padding: 2rem;
    max-width: 480px;
    width: 100%;
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
  }

  .tf-modal h2 {
    margin: 0 0 0.4rem;
    font-size: 1.4rem;
    padding-right: 2rem;
  }

  .tf-sub {
    margin: 0 0 1.25rem;
    color: var(--color-slate-600);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .tf-close {
