  { group: 19, artist: "Romantica Milonguera", genre: "Tango", singer: "Marisol Martínez y Roberto Minondi", era: "2018–2020", songs: [
    { title: "Duerme mi amor", singer: "Marisol Martínez y Roberto Minondi", date: "2018" }, { title: "Perfidia", singer: "Marisol Martínez y Roberto Minondi", date: "2018" }, { title: "Adios Corazon", singer: "Marisol Martínez y Roberto Minondi", date: "2018" }, { title: "Bomboncito", singer: "Marisol Martínez y Roberto Minondi", date: "2018" }, { title: "Buscandote", singer: "Marisol Martínez y Roberto Minondi", date: "2018" }, { title: "Fueron Tres Años", singer: "Marisol Martínez y Roberto Minondi", date: "2018" }, { title: "Poema", singer: "Marisol Martínez y Roberto Minondi", date: "2018" }, { title: "Todo es Amor", singer: "Marisol Martínez y Roberto Minondi", date: "2018" }, { title: "Tus labios me diran", singer: "Marisol Martínez y Roberto Minondi", date: "2020" }
  ]},
  { group: 20, artist: "Orquesta Típica Misteriosa Buenos Aires", genre: "Tango", singer: "Various", era: "2013", songs: [
    { title: "E.G.B", singer: "Instrumental", date: "2013" }, { title: "Invierno", singer: "Carlos Rossi", date: "2013" }, { title: "Quien sos", singer: "Instrumental", date: "2013" }, { title: "Quien Tiene tu Amor", singer: "Eliana Sosa", date: "2013" }, { title: "Seguir Viviendo Sin tu Amor", singer: "Eliana Sosa", date: "2013" }, { title: "Tu Corazón", singer: "Eliana Sosa", date: "2013" }
  ]},
];

function groupLabel(g: any): string {
  const genre = g.genre ? ` (${g.genre})` : ' (Tango)';
  return `${g.artist} — ${g.singer} ${g.era}${genre}`;
}
---

<BaseLayout title="Starting Set Lists" description="Curated tango DJ set lists for beginners. Download and browse organized tandas from the Golden Age.">
  <PageHero title="Starting Set Lists" lead="Curated songs organized into groups for building tandas. Download the spreadsheets or browse below." backHref="/dj/starter-kit/" backText="Back to Starter Kit" />

  <section class="downloads">
    <div class="container narrow-md">
      <div class="download-cards">
        <a href="/api/download?id=set-list-1" download class="download-card">
          <span class="download-icon">&#128196;</span>
          <div>
            <strong>Set List I &mdash; The Big Four</strong>
            <span>D'Arienzo, Di Sarli, Troilo, Pugliese (.csv)</span>
          </div>
          <span class="download-btn">Download</span>
        </a>
        <a href="/api/download?id=set-list-2" download class="download-card">
          <span class="download-icon">&#128196;</span>
          <div>
            <strong>Set List II &mdash; Expanded</strong>
            <span>Laurenz, Biagi, De Angelis, Cal&oacute;, Tanturi, Donato, Canaro, Fresedo (.csv)</span>
          </div>
          <span class="download-btn">Download</span>
        </a>
      </div>
    </div>
  </section>

  <section class="set-tables">
    <div class="container narrow-md">
      <h2 id="set-1">Set List I &mdash; The Big Four</h2>
      <p>Tangos from D'Arienzo, Di Sarli, Troilo, and Pugliese. Each group contains songs from the same orchestra, singer, and era &mdash; build 1&ndash;2 tandas from each.</p>

      {setI.map((g) => (
        <details class="group-details">
          <summary>
            <span class="group-num">Group {g.group}</span>
            <span class="group-label">{groupLabel(g)}</span>
          </summary>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Orchestra</th><th>Title</th><th>Singer</th><th>Date</th></tr></thead>
              <tbody>
                {g.songs.map((s) => (
                  <tr><td>{g.artist}</td><td>{s.title}</td><td>{g.singer}</td><td>{s.date}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}

      <h2 id="set-2" style="margin-top: 3rem;">Set List II &mdash; Expanded Orchestras</h2>
      <p>Additional orchestras plus Valses and Milongas.</p>

      {setII.map((g) => (
        <details class="group-details">
          <summary>
            <span class="group-num">Group {g.group}</span>
            <span class="group-label">{groupLabel(g)}</span>
          </summary>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Orchestra</th><th>Title</th><th>Singer</th><th>Date</th></tr></thead>
              <tbody>
                {g.songs.map((s) => (
                  <tr><td>{g.artist}</td><td>{s.title}</td><td>{g.singer}</td><td>{s.date}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section id="set-3-4" class="set-tables bonus-gate">
    <div class="container narrow-md">
      <div class="bonus-cta">
        <h2>Set Lists III &amp; IV</h2>
        <p>Set List III fills in much of what&rsquo;s missing from Sets I &amp; II &mdash; rounding out artists already covered and adding more key Golden Age orchestras. Set List IV covers later Golden Age recordings and key contemporary orchestras for the milonga. For those who can afford it, we ask for a <strong>suggested donation of $10</strong> for these set lists to help support the continued development of the Tango Toolkit.</p>
        <button type="button" class="btn btn-primary" data-donate-gate>View Set Lists III &amp; IV &rarr;</button>
      </div>

      <div data-donate-content hidden>
        <div class="download-cards">
          <a href="/api/download?id=set-list-3" download class="download-card">
            <span class="download-icon">&#128196;</span>
            <div>
              <strong>Set List III &mdash; Valses, Milongas &amp; More</strong>
              <span>Biagi, Troilo, Demare, Rodr&iacute;guez, D'Agostino, Tanturi, De Angelis, Malerba, Carabelli &amp; more (.csv)</span>
            </div>
            <span class="download-btn">Download</span>
          </a>
          <a href="/api/download?id=set-list-4" download class="download-card">
            <span class="download-icon">&#128196;</span>
            <div>
              <strong>Set List IV &mdash; Later Golden Age &amp; Contemporary</strong>
              <span>Pugliese, Troilo, Sassone, Gobbi, Varela, Salamanca, Sexteto Cristal, Rom&aacute;ntica Milonguera &amp; more (.csv)</span>
            </div>
            <span class="download-btn">Download</span>
          </a>
        </div>

        <h2>Set List III &mdash; Filling Out the Golden Age</h2>
        <p>Fills in much of what&rsquo;s missing from Sets I &amp; II &mdash; rounding out artists already covered and adding more key Golden Age orchestras: a Biagi milonga set, valses from Troilo, Demare, Rodr&iacute;guez, and D'Arienzo, and tango sets from D'Agostino, Tanturi, De Angelis, Di Sarli, Canaro, Malerba, and Carabelli. Singers vary within some groups, so the singer is listed per track.</p>

        {setIII.map((g) => (
          <details class="group-details">
            <summary>
              <span class="group-num">Group {g.group}</span>
              <span class="group-label">{groupLabel(g)}</span>
            </summary>
            <div class="table-scroll">
              <table>
                <thead><tr><th>Orchestra</th><th>Title</th><th>Singer</th><th>Date</th></tr></thead>
                <tbody>
                  {g.songs.map((s) => (
                    <tr><td>{g.artist}</td><td>{s.title}</td><td>{s.singer}</td><td>{s.date}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        ))}

        <h2 style="margin-top: 3rem;">Set List IV &mdash; Later Golden Age &amp; Contemporary</h2>
        <p>Later Golden Age recordings from Pugliese, Troilo, Sassone, Gobbi, Varela, Salamanca, and more, plus key contemporary orchestras for the modern milonga &mdash; Sexteto Cristal, Rom&aacute;ntica Milonguera, Juan Villarreal, and Orquesta T&iacute;pica Misteriosa. Includes tango, vals, and milonga sets; singers vary within some groups, so the singer is listed per track.</p>

        {setIV.map((g) => (
          <details class="group-details">
            <summary>
              <span class="group-num">Group {g.group}</span>
              <span class="group-label">{groupLabel(g)}</span>
            </summary>
            <div class="table-scroll">
              <table>
                <thead><tr><th>Orchestra</th><th>Title</th><th>Singer</th><th>Date</th></tr></thead>
                <tbody>
                  {g.songs.map((s) => (
                    <tr><td>{g.artist}</td><td>{s.title}</td><td>{s.singer}</td><td>{s.date}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        ))}

        <h2 style="margin-top: 3rem;">Additional Resources</h2>
        <p class="coming-soon">More library-building resources and DJ notes are on the way. Have a suggestion? Email <a href="mailto:tangotoolkit@gmail.com">tangotoolkit@gmail.com</a>.</p>
      </div>
    </div>
  </section>

  <DonationGate />
</BaseLayout>

<style>
  .downloads { padding: 2rem 0; }

  /* Anchored headings clear the sticky header when deep-linked */
  .set-tables h2[id],
  #set-3-4 {
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  .download-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .download-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: white;
    border: 2px solid var(--color-orange-300);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .download-card:hover {
    border-color: var(--color-orange-500);
    box-shadow: var(--shadow-md);
  }

  .download-icon { font-size: 1.5rem; }

  .download-card div {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .download-card strong { font-size: 0.95rem; }

  .download-card span:not(.download-icon):not(.download-btn) {
    font-size: 0.8rem;
    color: var(--color-slate-500);
  }

  .download-btn {
    padding: 0.4rem 0.75rem;
    background: var(--color-primary);
    color: white !important;
    border-radius: var(--radius-md);
    font-weight: 500;
    font-size: 0.85rem !important;
    white-space: nowrap;
  }

  .set-tables { padding: 0 0 3rem; }

  .set-tables h2 { margin: 0 0 0.5rem; }
  .set-tables > .container > p { color: var(--color-slate-600); margin: 0 0 1.5rem; }

  .group-details {
    margin-bottom: 0.5rem;
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .group-details[open] { border-color: var(--color-orange-300); }

  .group-details summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    background: var(--color-slate-50);
    font-size: 0.95rem;
    list-style: none;
  }

  .group-details summary::-webkit-details-marker { display: none; }
  .group-details summary::before { content: "▸"; font-size: 0.8rem; color: var(--color-slate-400); }
  .group-details[open] summary::before { content: "▾"; }

  .group-num {
    font-weight: 600;
    color: var(--color-orange-600);
    white-space: nowrap;
  }

  .group-label { color: var(--color-slate-700); }

  .table-scroll { overflow-x: auto; }

  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  thead { background: var(--color-orange-50); }
  th, td { padding: 0.4rem 0.75rem; border: 1px solid var(--color-slate-200); text-align: left; }
  th { font-weight: 600; }

  [data-donate-content][hidden] { display: none; }

  .bonus-cta {
    background: linear-gradient(135deg, var(--color-orange-50) 0%, white 100%);
    border: 2px solid var(--color-orange-300);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .bonus-cta h2 { margin: 0 0 0.5rem; border: none; padding: 0; }
  .bonus-cta p { color: var(--color-slate-600); margin: 0 0 1.25rem; }

  .coming-soon {
    color: var(--color-slate-500);
    font-style: italic;
  }
</style>
