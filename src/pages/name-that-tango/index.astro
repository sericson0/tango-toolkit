---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import RegisterGate from '../../components/RegisterGate.astro';
import UsageTracker from '../../components/UsageTracker.astro';
import { eras } from '../../data/eras';
---

<BaseLayout title="Name That Tango" description="Listen to a tango clip and guess the bandleader, title, singer, or year. Ear-training for tango DJs and dancers.">
  <PageHero title="Name That Tango" lead="Hear a clip — name the orchestra, title, singer, or year. Ear training for tango DJs and dancers." compact />
  <div class="ntt-container" id="nttRoot" data-audio-base={import.meta.env.PUBLIC_AUDIO_BASE_URL || ''}>

    <!-- Section 1: Setup -->
    <div class="ntt-section ntt-setup-section" id="setupSection">
      <div class="ntt-section-header">
        <h2>Set Up Your Game</h2>
        <span class="ntt-stats" id="loadStats"></span>
      </div>

      <div class="ntt-controls">
        <div class="ntt-control" id="moduleSelectWrap">
          <label for="moduleSelect">Game</label>
          <select id="moduleSelect" title="Choose which quiz to play">
            <option value="orchestra" title="Pick one orchestra and quiz yourself only on its songs">Learn an Orchestra</option>
            <option value="bigfour" title="Quiz on D'Arienzo, Di Sarli, Pugliese and Troilo — tango's four most iconic bandleaders">The Big Four</option>
            <option value="goldenage" title="Quiz on any orchestra recording from the Golden Age of tango (1935-1959)">Golden Age</option>
            <option value="daily" title="Five Golden Age songs, the same for every player — a new set each day">Daily Challenge</option>
            <option value="matching" title="Drag or tap tiles to match audio clips to their orchestra (and title)">Matching</option>
          </select>
        </div>
        <div class="ntt-control" id="orchestraPickerWrap">
          <label for="orchestraSearch">Orchestra</label>
          <div class="ntt-combo">
            <input type="text" id="orchestraSearch" class="ntt-combo-input" autocomplete="off" placeholder="Choose an orchestra..." title="Search by name — accents optional" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="orchestraComboList">
            <div class="ntt-combo-list" id="orchestraComboList" role="listbox" hidden></div>
            <select id="orchestraSelect" class="ntt-combo-native" aria-hidden="true" tabindex="-1"><option value="">Choose an orchestra...</option></select>
          </div>
        </div>
        <div class="ntt-control" id="eraPickerWrap" style="display:none;">
          <label for="eraSearch">Era</label>
          <div class="ntt-combo">
            <input type="text" id="eraSearch" class="ntt-combo-input" autocomplete="off" placeholder="Choose an era..." role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="eraComboList">
            <div class="ntt-combo-list" id="eraComboList" role="listbox" hidden></div>
            <select id="eraSelect" class="ntt-combo-native" aria-hidden="true" tabindex="-1"><option value="">Choose an era...</option></select>
          </div>
        </div>
        <div class="ntt-control ntt-bigfour-ranges-wrap" id="bigFourRangeWrap" style="display:none;">
          <label>Date Range</label>
          <div class="ntt-range-checks">
            <label class="ntt-range-check"><input type="checkbox" class="ntt-range-checkbox" data-range="pre" checked> Pre Golden Age (&lt; 1935)</label>
            <label class="ntt-range-check"><input type="checkbox" class="ntt-range-checkbox" data-range="early" checked> Early Golden Age (1935&ndash;1949)</label>
            <label class="ntt-range-check"><input type="checkbox" class="ntt-range-checkbox" data-range="later" checked> Later Golden Age (1950&ndash;1959)</label>
            <label class="ntt-range-check"><input type="checkbox" class="ntt-range-checkbox" data-range="post" checked> Post 50s (&ge; 1960)</label>
          </div>
        </div>
        <div class="ntt-control ntt-bigfour-ranges-wrap" id="goldenAgeRangeWrap" style="display:none;">
          <label>Golden Age Period</label>
          <div class="ntt-range-checks">
            <label class="ntt-range-check"><input type="checkbox" class="ntt-golden-range-checkbox" data-range="early" checked> Early Golden Age (1935&ndash;1949)</label>
            <label class="ntt-range-check"><input type="checkbox" class="ntt-golden-range-checkbox" data-range="later" checked> Later Golden Age (1950&ndash;1959)</label>
          </div>
        </div>
        <div class="ntt-control" id="levelWrap">
          <label for="levelSelect">Difficulty</label>
          <select id="levelSelect"></select>
          <span class="ntt-level-desc" id="levelDesc"></span>
        </div>
        <div class="ntt-control" id="roundsWrap">
          <label for="roundsSelect">Rounds</label>
          <select id="roundsSelect" title="How many songs to play this session">
            <option value="5">5 songs</option>
            <option value="8" selected>8 songs</option>
            <option value="15">15 songs</option>
          </select>
        </div>
      </div>

      <p class="ntt-pool-info" id="poolInfo">Pick an orchestra to begin.</p>

      <button type="button" class="ntt-btn-primary" id="startBtn" disabled title="Start a session with these settings">Start Quiz</button>

      <!-- Persistent progress (localStorage) -->
      <div class="ntt-stats-panel" id="statsPanel" hidden>
        <button type="button" class="ntt-stats-toggle" id="statsToggle" aria-expanded="false" title="Lifetime accuracy, saved on this device">Your progress &#9662;</button>
        <div class="ntt-stats-body" id="statsBody" hidden></div>
      </div>
    </div>

    <!-- Section 2: Quiz -->
    <div class="ntt-section ntt-quiz-section" id="quizSection" style="display:none;">
      <div class="ntt-quiz-header">
        <span class="ntt-round-counter" id="roundCounter"></span>
        <span class="ntt-quiz-context" id="quizContext"></span>
        <span class="ntt-score" id="scoreDisplay"></span>
        <span class="ntt-streak" id="streakDisplay"></span>
        <button type="button" class="ntt-btn-text" id="endQuizBtn" title="End the session now and see your summary">End Quiz</button>
      </div>

      <div class="ntt-player">
        <audio id="clipAudio" preload="metadata"></audio>
        <button type="button" class="ntt-btn-play" id="playBtn" title="Play a 30-second clip (Space)">&#9654; Play Clip</button>
        <button type="button" class="ntt-btn-secondary ntt-btn-shift" id="laterClipBtn" title="Replay the clip starting 30 seconds later in the song">Later clip &#9193;</button>
        <span class="ntt-player-status" id="playerStatus"></span>
        <button type="button" class="ntt-btn-secondary ntt-action-btn" id="skipBtn" title="Give up on this song — reveals the answer without counting against your score (S)">Skip</button>
        <button type="button" class="ntt-btn-primary ntt-action-btn" id="submitBtn" title="Grade your answer (Enter)">Submit Answer</button>
        <button type="button" class="ntt-btn-primary ntt-action-btn" id="nextBtn" style="display:none;" title="Go to the next song (Enter)">Next Song &rarr;</button>
      </div>
      <div class="ntt-progress" id="clipProgress" aria-hidden="true"><div class="ntt-progress-bar" id="clipProgressBar"></div></div>

      <p class="ntt-kbd-hint">Shortcuts: <kbd>Space</kbd> play/pause &middot; <kbd>Enter</kbd> submit / next &middot; <kbd>S</kbd> skip &middot; <kbd>1</kbd>&ndash;<kbd>4</kbd> pick choice</p>

      <div id="answerArea"></div>
      <p class="ntt-answer-hint" id="answerHint" hidden></p>

      <!-- Reveal: discographies-style song detail -->
      <div class="ntt-reveal" id="revealPanel" style="display:none;">
        <div class="ntt-reveal-banner" id="revealBanner"></div>
        <button type="button" class="ntt-btn-listen" id="listenFullBtn" title="Hear the whole recording from the beginning">&#9654; Listen from the top</button>
        <div class="ntt-detail-meta" id="detailMeta"></div>
        <button type="button" class="ntt-btn-more" id="moreDetailsBtn" title="Show composer, lineup and other recording details">More details &#9662;</button>
        <div class="ntt-detail-grid" id="detailGrid" style="display:none;"></div>
      </div>
    </div>

    <!-- Section 2b: Matching game -->
    <div class="ntt-section ntt-matching-section" id="matchingSection" style="display:none;">
      <div class="ntt-quiz-header">
        <span class="ntt-round-counter">Match each song to its orchestra</span>
        <span class="ntt-score" id="matchingScore"></span>
        <button type="button" class="ntt-btn-text" id="matchingEndBtn" title="Abandon this board and go back to setup">End</button>
      </div>
      <p class="ntt-pool-info" id="matchingHint"></p>
      <div id="matchingBoard"></div>
      <div class="ntt-summary-actions">
        <button type="button" class="ntt-btn-primary" id="matchingSubmitBtn" title="Grade your matches">Submit Matches</button>
        <button type="button" class="ntt-btn-primary" id="matchingPlayAgainBtn" style="display:none;" title="New board with the same settings">Play Again</button>
        <button type="button" class="ntt-btn-secondary" id="matchingChangeBtn" style="display:none;" title="Back to setup to pick a different game or difficulty">New Game</button>
      </div>
    </div>

    <!-- Section 3: Summary -->
    <div class="ntt-section ntt-summary-section" id="summarySection" style="display:none;">
      <div class="ntt-section-header">
        <h2>Session Summary</h2>
      </div>
      <p class="ntt-summary-score" id="summaryScore"></p>
      <div class="ntt-table-wrap">
        <table class="ntt-table" id="summaryTable">
          <thead>
            <tr id="summaryHead"><th></th><th>Song</th><th>Result</th></tr>
          </thead>
          <tbody id="summaryBody"></tbody>
        </table>
      </div>
      <div class="ntt-summary-actions">
        <button type="button" class="ntt-btn-primary" id="playAgainBtn" title="Same settings, new random songs">Play Again</button>
        <button type="button" class="ntt-btn-secondary" id="replayMissesBtn" style="display:none;" title="A fresh mini-session with just the songs you missed">Replay missed songs</button>
        <button type="button" class="ntt-btn-secondary" id="shareResultBtn" title="Show a shareable result card">Share with friends</button>
        <button type="button" class="ntt-btn-secondary" id="changeSettingsBtn" title="Back to setup to pick a different game or difficulty">New Game</button>
      </div>

      <!-- Shareable result card (revealed by "Share with friends") -->
      <div class="ntt-share-card" id="shareCard" hidden>
        <p class="ntt-share-title" id="shareCardTitle"></p>
        <div class="ntt-share-grid" id="shareCardGrid"></div>
        <p class="ntt-share-score" id="shareCardScore"></p>
        <button type="button" class="ntt-btn-primary" id="shareCopyBtn" title="Copy your result and the link to the clipboard">Copy to clipboard</button>
        <p class="ntt-share-hint">Copies your grid plus the link below so friends can try the same quiz.</p>
        <a class="ntt-share-link" id="shareCardLink" href="#" target="_blank" rel="noopener">Share this game with friends &rarr;</a>
      </div>
    </div>

  </div>

  <script define:vars={{ erasConfig: eras }}>
    window.__NTT_ERAS__ = erasConfig;
  </script>

  <!-- Papa Parse (self-hosted — no third-party dependency at load time) -->
  <script is:inline src="/vendor/papaparse.min.js"></script>

  <script>
    import '../../scripts/name-that-tango/main.js';
  </script>

  <RegisterGate toolName="Name That Tango" />
  <UsageTracker />
</BaseLayout>

<style is:global>
  .ntt-container {
    max-width: 60rem;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 3rem;
  }

  .ntt-section {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
  }

  .ntt-section-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .ntt-section-header h2 {
    font-size: 1.4rem;
    margin: 0;
  }
  .ntt-stats {
    font-size: 0.75rem;
    color: var(--color-slate-400);
    margin-left: auto;
  }

  /* Controls */
  .ntt-controls {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  .ntt-control {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
    min-width: 180px;
  }
  .ntt-control label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--color-slate-500);
  }
  .ntt-control select {
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--color-slate-300);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    background: var(--color-slate-50);
    color: var(--color-slate-800);
  }
  .ntt-level-desc {
    font-size: 0.72rem;
    color: var(--color-slate-500);
    line-height: 1.35;
  }

  /* Big Four date-range checkboxes */
  .ntt-bigfour-ranges-wrap { flex: 1 1 100%; }
  .ntt-range-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
  }
  .ntt-range-check {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-slate-700);
    cursor: pointer;
  }
  .ntt-range-check input { accent-color: var(--color-primary); }

  /* Accent-folding search combobox (orchestra/era picker, quiz type-in fields) */
  .ntt-combo { position: relative; }
  .ntt-combo-native { display: none; }
  .ntt-combo-input {
    width: 100%;
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--color-slate-300);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    background: var(--color-slate-50);
    color: var(--color-slate-800);
  }
  .ntt-combo-input:focus { outline: 2px solid var(--color-primary); outline-offset: 1px; }
  .ntt-combo-list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    margin-top: 0.2rem;
    max-height: 14rem;
    overflow-y: auto;
    background: white;
    border: 1px solid var(--color-slate-300);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }
  .ntt-combo-option {
    padding: 0.4rem 0.6rem;
    font-size: 0.88rem;
    color: var(--color-slate-700);
    cursor: pointer;
  }
  .ntt-combo-option:hover { background: var(--color-orange-50); }

  .ntt-pool-info {
    font-size: 0.85rem;
    color: var(--color-slate-500);
    margin: 0 0 0.75rem;
  }

  /* Highlighted option during keyboard navigation of a suggestion list */
  .ntt-combo-option.active { background: var(--color-orange-100, var(--color-orange-50)); }

  /* Persistent progress panel */
  .ntt-stats-panel { margin-top: 1rem; border-top: 1px solid var(--color-slate-100); padding-top: 0.75rem; }
  .ntt-stats-toggle {
    background: none; border: none; padding: 0.2rem 0; cursor: pointer;
    font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600; color: var(--color-orange-700);
  }
  .ntt-stats-body { margin-top: 0.6rem; }
  .ntt-stats-row { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-bottom: 0.75rem; }
  .ntt-stat { font-size: 0.85rem; color: var(--color-slate-600); }
  .ntt-stat strong { color: var(--color-slate-900); font-size: 1rem; }
  .ntt-stats-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; max-width: 28rem; }
  .ntt-stats-table th {
    text-align: left; padding: 0.25rem 0.5rem; font-size: 0.6rem; text-transform: uppercase;
    letter-spacing: 0.8px; color: var(--color-slate-500); border-bottom: 1px solid var(--color-slate-200);
  }
  .ntt-stats-table td { padding: 0.25rem 0.5rem; border-bottom: 1px solid var(--color-slate-100); color: var(--color-slate-700); }
  .ntt-stats-reset { margin-top: 0.6rem; margin-left: 0; text-decoration: underline; }

  .ntt-btn-primary, .ntt-btn-secondary {
    padding: 0.6rem 1.4rem;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
    font-family: var(--font-sans);
  }
  .ntt-btn-primary { background: var(--color-primary); color: white; }
  .ntt-btn-primary:hover:not(:disabled) { background: var(--color-primary-hover); }
  .ntt-btn-primary:disabled { background: var(--color-slate-300); cursor: not-allowed; }
  .ntt-btn-secondary { background: var(--color-slate-100); color: var(--color-slate-700); }
  .ntt-btn-secondary:hover { background: var(--color-slate-200); }

  /* Quiz header */
  .ntt-quiz-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: -1.25rem -1.5rem 1.25rem;
    padding: 0.85rem 1.5rem;
    border-bottom: 2px solid var(--color-orange-200);
    background: var(--color-orange-50);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    font-size: 0.9rem;
    color: var(--color-slate-600);
    font-weight: 500;
  }
  .ntt-round-counter { font-weight: 700; color: var(--color-slate-800); }
  .ntt-quiz-context {
    color: var(--color-slate-500);
    font-size: 0.8rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Live fully-correct streak (lifetime, from saved stats) */
  .ntt-streak {
    color: var(--color-orange-700);
    font-weight: 700;
    white-space: nowrap;
  }
  .ntt-btn-text {
    margin-left: auto;
    background: none;
    border: none;
    padding: 0.2rem 0.4rem;
    color: var(--color-slate-400);
    font-size: 0.8rem;
    font-family: var(--font-sans);
    cursor: pointer;
    text-decoration: underline;
  }
  .ntt-btn-text:hover { color: var(--color-red-600); }

  /* Player */
  .ntt-player {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-slate-100);
  }
  .ntt-btn-play {
    padding: 0.6rem 1.2rem;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-orange-500);
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    font-family: var(--font-sans);
    min-width: 8.5rem;
  }
  .ntt-btn-play:hover { background: var(--color-orange-600); }
  .ntt-player-status {
    font-size: 0.8rem;
    color: var(--color-slate-400);
  }
  /* Submit / Next / Skip sit at the right edge of the player row. Skip and Next
     each claim the leading auto-margin; Submit tucks in beside Skip. */
  .ntt-action-btn { margin-left: auto; }
  #submitBtn.ntt-action-btn { margin-left: 0.5rem; }

  /* Clip progress bar */
  .ntt-progress {
    height: 4px;
    background: var(--color-slate-100);
    border-radius: 999px;
    overflow: hidden;
    margin: 0 0 0.75rem;
  }
  .ntt-progress-bar {
    height: 100%;
    width: 0;
    background: var(--color-orange-500);
    transition: width 0.15s linear;
  }

  /* Keyboard shortcut hint (pointless noise on touch-only devices) */
  .ntt-kbd-hint {
    font-size: 0.75rem;
    color: var(--color-slate-400);
    margin: 0 0 1rem;
  }
  @media (hover: none) and (pointer: coarse) {
    .ntt-kbd-hint { display: none; }
  }
  .ntt-kbd-hint kbd {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    background: var(--color-slate-100);
    border: 1px solid var(--color-slate-300);
    border-radius: 3px;
    padding: 0.05rem 0.3rem;
    color: var(--color-slate-600);
  }

  /* Reveal "listen from the top" button */
  .ntt-btn-listen {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-orange-300);
    border-radius: var(--radius-md);
    background: white;
    color: var(--color-orange-700);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .ntt-btn-listen:hover { background: var(--color-orange-50); }

  /* Answer fields */
  .ntt-field { margin-bottom: 1rem; }
  .ntt-field-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--color-slate-500);
    margin-bottom: 0.4rem;
  }
  .ntt-mc-group {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  .ntt-mc-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-slate-300);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--color-slate-700);
  }
  .ntt-mc-option:hover { background: var(--color-orange-50); border-color: var(--color-orange-300); }
  .ntt-mc-option input { accent-color: var(--color-primary); }
  /* Make the picked option unmistakable — the radio dot alone is easy to lose,
     especially on the photo tiles. (:has is ignored by older browsers.) */
  .ntt-mc-option:has(input:checked) {
    background: var(--color-orange-50);
    border-color: var(--color-primary);
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }
  /* Bandleader options carry a portrait thumbnail */
  .ntt-mc-option-thumb { padding: 0.4rem 0.6rem; }
  .ntt-mc-thumb {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-sm);
    object-fit: cover;
    flex-shrink: 0;
    background: var(--color-slate-100);
  }
  .ntt-text-input {
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--color-slate-300);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-family: var(--font-sans);
    background: var(--color-slate-50);
  }
  .ntt-text-input:focus { outline: 2px solid var(--color-primary); outline-offset: 1px; }

  /* Blank-submit nudge */
  .ntt-answer-hint {
    font-size: 0.85rem;
    color: var(--color-orange-700);
    background: var(--color-orange-50);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
    margin: 0 0 1rem;
  }

  /* Reveal banner */
  .ntt-reveal-banner {
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .ntt-reveal-banner-correct { background: var(--color-green-50); color: var(--color-green-700); }
